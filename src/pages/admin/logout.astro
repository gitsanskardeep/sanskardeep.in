---
export const prerender = false; // Admin SSR route

import { destroyAdminSession, SESSION_COOKIE_NAME } from '../../lib/auth';

const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (sessionToken) {
  try {
    const { env } = await import('cloudflare:workers');
    const kv = (env as Record<string, unknown>).SESSION as import('@cloudflare/workers-types').KVNamespace | undefined;
    if (kv) {
      await destroyAdminSession(kv, sessionToken);
    }
  } catch (err) {
    console.warn('Logout: KV session destruction warning:', err);
  }

  // Clear HTTP cookie
  Astro.cookies.delete(SESSION_COOKIE_NAME, { path: '/' });
}

return Astro.redirect('/admin/login?msg=' + encodeURIComponent('You have been securely logged out.'));
---
