---
export const prerender = false; // Admin SSR route

import Layout from '../../../layouts/Layout.astro';
import { 
  createBlogPost, 
  generateSlug, 
  getClasses, 
  getCategories 
} from '../../../lib/blog';
import BlogForm from '../../../components/admin/BlogForm.astro';
import { getAdminSession, SESSION_COOKIE_NAME } from '../../../lib/auth';
import type { SessionUser } from '../../../lib/auth';

// Cloudflare v14 bindings
let db: import('@cloudflare/workers-types').D1Database | undefined;
let sessionKV: import('@cloudflare/workers-types').KVNamespace | undefined;
try {
  const { env } = await import('cloudflare:workers');
  db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
  sessionKV = (env as Record<string, unknown>).SESSION as import('@cloudflare/workers-types').KVNamespace | undefined;
} catch {
  db = undefined;
  sessionKV = undefined;
}

// Session verification
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
let currentUser: SessionUser | null = Astro.locals.user || null;

if (!currentUser && sessionToken && sessionKV) {
  currentUser = await getAdminSession(sessionKV, sessionToken);
}

if (!currentUser) {
  return Astro.redirect('/admin/login?err=' + encodeURIComponent('Please sign in to access the Blog Manager.'));
}

let formError = '';

// Handle Create Form Submission (POST)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (!db) {
      formError = 'Database connection is currently unavailable.';
    } else if (action === 'create') {
      const title_english = formData.get('title_english')?.toString().trim();
      const title_gujarati = formData.get('title_gujarati')?.toString().trim() || null;
      let slug = formData.get('slug')?.toString().trim();
      const category = formData.get('category')?.toString().trim() || 'Exam Strategy';
      const category_id = parseInt(formData.get('category_id')?.toString() || '0', 10) || null;
      const class_id = parseInt(formData.get('class_id')?.toString() || '0', 10) || null;
      const summary = formData.get('summary')?.toString().trim();
      const content_markdown = formData.get('content_markdown')?.toString().trim() || null;
      const content_rich = formData.get('content_rich')?.toString().trim() || null;
      const thumbnail_url = formData.get('thumbnail_url')?.toString().trim() || null;
      const read_time = formData.get('read_time')?.toString().trim() || '5 min read';
      const published_at = formData.get('published_at')?.toString().trim() || new Date().toISOString().split('T')[0];
      const status = (formData.get('status')?.toString() === 'draft') ? 'draft' : 'published';
      const display_order = parseInt(formData.get('display_order')?.toString() || '0', 10) || 0;

      if (!title_english || !summary) {
        formError = 'English Title and Short Summary are required.';
      } else {
        if (!slug) {
          slug = generateSlug(title_english);
        }

        const ok = await createBlogPost(db, {
          slug,
          title_english,
          title_gujarati,
          category,
          category_id,
          class_id,
          summary,
          content_markdown,
          content_rich,
          thumbnail_url,
          read_time,
          published_at,
          status,
          display_order
        });

        if (ok) {
          return Astro.redirect('/admin/blog?msg=' + encodeURIComponent(`Article "${title_english}" was created successfully!`));
        } else {
          formError = 'Failed to insert article into D1. Check if slug already exists.';
        }
      }
    }
  } catch (err: any) {
    formError = err?.message || 'An unexpected error occurred.';
  }
}

// Fetch classes and categories for dropdowns
const classesList = await getClasses(db);
const categoriesList = await getCategories(db);
---

<Layout title="Write New Article - Admin Blog Manager" description="Compose and publish new educational articles.">
  <div class="admin-page">
    <div class="container container-form">
      <!-- Navigation & Header Bar -->
      <div class="form-page-header">
        <a href="/admin/blog" class="btn btn-outline btn-sm back-btn">
          <span>&larr; Back to Articles</span>
        </a>
        <div class="header-content">
          <h1 class="page-title">Write New Article</h1>
          <p class="page-sub">Compose GSEB exam guidance, subject analyses, or formula study notes.</p>
        </div>
      </div>

      {formError && <div class="alert alert-error">{formError}</div>}

      <!-- Form Card -->
      <div class="card form-card">
        <BlogForm 
          classesList={classesList}
          categoriesList={categoriesList}
          cancelUrl="/admin/blog"
        />
      </div>
    </div>
  </div>
</Layout>

<style>
  .admin-page {
    padding: 3rem 0 4rem;
    background-color: var(--color-bg-main);
  }

  .container-form {
    max-width: 1040px;
    margin: 0 auto;
  }

  .form-page-header {
    margin-bottom: 2rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    color: var(--color-text-medium);
  }

  .page-title {
    font-size: 2rem;
    color: var(--color-primary-navy);
    margin-bottom: 0.35rem;
  }

  .page-sub {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .alert {
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .alert-error {
    background-color: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fca5a5;
  }

  .form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .form-card {
      padding: 1.25rem;
    }
  }
</style>
