---
export const prerender = false; // Admin SSR route

import Layout from '../../../../layouts/Layout.astro';
import { 
  getTestById, 
  getQuestionsByTestId, 
  createQuestion, 
  updateQuestion, 
  deleteQuestion,
  reorderQuestions,
  validateQuestion,
  SECTION_A_QUESTION_TYPES,
  SECTION_A_QUESTION_SOURCES
} from '../../../../lib/tests';
import { getAdminSession, SESSION_COOKIE_NAME } from '../../../../lib/auth';
import type { SessionUser } from '../../../../lib/auth';
import type { QuestionRecord } from '../../../../db/schema';

// Cloudflare v14 bindings
let db: import('@cloudflare/workers-types').D1Database | undefined;
let sessionKV: import('@cloudflare/workers-types').KVNamespace | undefined;
try {
  const { env } = await import('cloudflare:workers');
  db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
  sessionKV = (env as Record<string, unknown>).SESSION as import('@cloudflare/workers-types').KVNamespace | undefined;
} catch {
  db = undefined;
  sessionKV = undefined;
}

// Session verification
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
let currentUser: SessionUser | null = Astro.locals.user || null;

if (!currentUser && sessionToken && sessionKV) {
  currentUser = await getAdminSession(sessionKV, sessionToken);
}

if (!currentUser) {
  return Astro.redirect('/admin/login?err=' + encodeURIComponent('Please sign in to access the Tests Manager.'));
}

const { id } = Astro.params;
const testId = parseInt(id || '0', 10);

if (!testId || isNaN(testId)) {
  return Astro.redirect('/admin/tests?err=' + encodeURIComponent('Invalid test ID provided.'));
}

let test = null;
if (db) {
  test = await getTestById(db, testId);
}

if (!test) {
  return Astro.redirect('/admin/tests?err=' + encodeURIComponent('The requested test was not found.'));
}

let formError = '';
let formSuccess = '';

// Handle Actions (POST)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (!db) {
      formError = 'Database connection is currently unavailable.';
    } else if (action === 'create_question') {
      const question_type = formData.get('question_type')?.toString().trim() || 'mcq';
      const question_source = formData.get('question_source')?.toString().trim() || 'text';
      const question_text_english = formData.get('question_text_english')?.toString().trim() || '';
      const question_text_gujarati = formData.get('question_text_gujarati')?.toString().trim() || null;
      const option_a = formData.get('option_a')?.toString().trim() || null;
      const option_b = formData.get('option_b')?.toString().trim() || null;
      const option_c = formData.get('option_c')?.toString().trim() || null;
      const option_d = formData.get('option_d')?.toString().trim() || null;
      const correct_option = (formData.get('correct_option')?.toString().trim() || null) as ('A' | 'B' | 'C' | 'D' | null);
      const correct_answer_text = formData.get('correct_answer_text')?.toString().trim() || null;
      const marks = parseInt(formData.get('marks')?.toString() || '1', 10) || 1;
      const explanation = formData.get('explanation')?.toString().trim() || null;

      const validation = validateQuestion({
        test_id: testId,
        question_type,
        question_source,
        question_text_english,
        question_text_gujarati,
        option_a,
        option_b,
        option_c,
        option_d,
        correct_option,
        correct_answer_text,
        marks,
        explanation
      });

      if (!validation.valid) {
        formError = validation.errors.join(' ');
      } else {
        const ok = await createQuestion(db, {
          test_id: testId,
          question_type,
          question_source,
          question_text_english,
          question_text_gujarati,
          option_a,
          option_b,
          option_c,
          option_d,
          correct_option,
          correct_answer_text,
          marks,
          explanation
        });

        if (ok) {
          return Astro.redirect(`/admin/tests/${testId}/questions?msg=` + encodeURIComponent('Question added successfully!'));
        } else {
          formError = 'Failed to insert question into D1 database.';
        }
      }
    } else if (action === 'update_question') {
      const question_id = parseInt(formData.get('question_id')?.toString() || '0', 10);
      const question_type = formData.get('question_type')?.toString().trim() || 'mcq';
      const question_source = formData.get('question_source')?.toString().trim() || 'text';
      const question_text_english = formData.get('question_text_english')?.toString().trim() || '';
      const question_text_gujarati = formData.get('question_text_gujarati')?.toString().trim() || null;
      const option_a = formData.get('option_a')?.toString().trim() || null;
      const option_b = formData.get('option_b')?.toString().trim() || null;
      const option_c = formData.get('option_c')?.toString().trim() || null;
      const option_d = formData.get('option_d')?.toString().trim() || null;
      const correct_option = (formData.get('correct_option')?.toString().trim() || null) as ('A' | 'B' | 'C' | 'D' | null);
      const correct_answer_text = formData.get('correct_answer_text')?.toString().trim() || null;
      const marks = parseInt(formData.get('marks')?.toString() || '1', 10) || 1;
      const explanation = formData.get('explanation')?.toString().trim() || null;

      if (!question_id) {
        formError = 'Question ID is required for editing.';
      } else {
        const validation = validateQuestion({
          test_id: testId,
          question_type,
          question_source,
          question_text_english,
          question_text_gujarati,
          option_a,
          option_b,
          option_c,
          option_d,
          correct_option,
          correct_answer_text,
          marks,
          explanation
        });

        if (!validation.valid) {
          formError = validation.errors.join(' ');
        } else {
          const ok = await updateQuestion(db, {
            id: question_id,
            test_id: testId,
            question_type,
            question_source,
            question_text_english,
            question_text_gujarati,
            option_a,
            option_b,
            option_c,
            option_d,
            correct_option,
            correct_answer_text,
            marks,
            explanation
          });

          if (ok) {
            return Astro.redirect(`/admin/tests/${testId}/questions?msg=` + encodeURIComponent('Question updated successfully!'));
          } else {
            formError = 'Failed to update question in D1 database.';
          }
        }
      }
    } else if (action === 'delete_question') {
      const question_id = parseInt(formData.get('question_id')?.toString() || '0', 10);
      if (question_id) {
        const ok = await deleteQuestion(db, question_id);
        if (ok) {
          return Astro.redirect(`/admin/tests/${testId}/questions?msg=` + encodeURIComponent('Question deleted successfully!'));
        } else {
          formError = 'Failed to delete question from database.';
        }
      }
    } else if (action === 'move_question') {
      const question_id = parseInt(formData.get('question_id')?.toString() || '0', 10);
      const direction = formData.get('direction')?.toString();
      const allQ = await getQuestionsByTestId(db, testId);
      const currentIndex = allQ.findIndex(q => q.id === question_id);

      if (currentIndex !== -1) {
        const targetIndex = direction === 'up' ? currentIndex - 1 : currentIndex + 1;
        if (targetIndex >= 0 && targetIndex < allQ.length) {
          const newOrder = [...allQ];
          const [moved] = newOrder.splice(currentIndex, 1);
          newOrder.splice(targetIndex, 0, moved);
          await reorderQuestions(db, testId, newOrder.map(q => q.id));
          return Astro.redirect(`/admin/tests/${testId}/questions?msg=` + encodeURIComponent('Question order updated!'));
        }
      }
    }
  } catch (err: any) {
    formError = err?.message || 'An unexpected error occurred.';
  }
}

// Fetch all questions for this test
let questions: QuestionRecord[] = [];
if (db) {
  questions = await getQuestionsByTestId(db, testId);
}

// Check edit question query param: ?edit=123
const editParam = Astro.url.searchParams.get('edit');
const editId = editParam ? parseInt(editParam, 10) : 0;
const editingQuestion = editId ? questions.find(q => q.id === editId) || null : null;

// KPI calculations
const totalMarksConfigured = test.total_marks || 50;
const currentMarksAdded = questions.reduce((sum, q) => sum + (q.marks || 0), 0);
const marksDifference = totalMarksConfigured - currentMarksAdded;

const successMsg = Astro.url.searchParams.get('msg');
const isSectionATest = test.test_type === 'Section-A Question Test';
---

<Layout title={`Manage Questions - ${test.title} | Admin Portal`}>
  <div class="admin-page-container">
    <div class="container">

      <!-- Breadcrumbs & Navigation -->
      <div class="admin-breadcrumbs">
        <a href="/admin/tests" class="breadcrumb-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Back to Tests List
        </a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">Manage Questions</span>
      </div>

      <!-- Header Section -->
      <div class="admin-header-card">
        <div class="header-main">
          <div class="header-badges">
            <span class="badge badge-accent">{test.className || 'General'}</span>
            {test.subjectName && <span class="badge badge-primary">{test.subjectName}</span>}
            <span class="badge badge-type">{test.test_type}</span>
            <span class={`status-badge ${test.status === 'published' ? 'status-published' : 'status-draft'}`}>
              {test.status}
            </span>
          </div>
          <h1 class="page-title">{test.title}</h1>
          {test.chapter && <p class="test-submeta">Chapter / Syllabus: <strong>{test.chapter}</strong></p>}
        </div>

        <div class="header-actions">
          <a href={`/admin/tests/edit/${test.id}`} class="btn btn-outline btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>Edit Test Settings</span>
          </a>
        </div>
      </div>

      <!-- Warning if test_type is not Section-A -->
      {!isSectionATest && (
        <div class="alert alert-warning">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <div>
            <strong>Notice:</strong> This test is configured as a "<strong>{test.test_type}</strong>". Section-A Question Management is designed primarily for "<strong>Section-A Question Test</strong>". You can edit the test type in <a href={`/admin/tests/edit/${test.id}`} style="text-decoration: underline;">Test Settings</a>.
          </div>
        </div>
      )}

      <!-- Alert Messages -->
      {formError && (
        <div class="alert alert-danger" role="alert">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>{formError}</span>
        </div>
      )}

      {successMsg && (
        <div class="alert alert-success" role="alert">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span>{successMsg}</span>
        </div>
      )}

      <!-- KPI Summary Cards -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">Configured Total Marks</div>
          <div class="kpi-value">{totalMarksConfigured}</div>
          <div class="kpi-desc">Target marks for this test paper</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-label">Current Marks Added</div>
          <div class="kpi-value" style={currentMarksAdded === totalMarksConfigured ? 'color: #059669;' : currentMarksAdded > totalMarksConfigured ? 'color: #dc2626;' : 'color: #d97706;'}>
            {currentMarksAdded} / {totalMarksConfigured}
          </div>
          <div class="kpi-desc">
            {marksDifference === 0 ? '✓ Target exact match' : marksDifference > 0 ? `${marksDifference} marks remaining to add` : `${Math.abs(marksDifference)} marks over target`}
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-label">Total Questions</div>
          <div class="kpi-value">{questions.length}</div>
          <div class="kpi-desc">Questions registered in Section-A</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-label">Test Duration</div>
          <div class="kpi-value">{test.duration_minutes}m</div>
          <div class="kpi-desc">Allocated time for students</div>
        </div>
      </div>

      <!-- Main Layout: Question List + Add/Edit Form -->
      <div class="management-grid">

        <!-- Question List (Left) -->
        <div class="questions-list-column">
          <div class="card section-card">
            <div class="section-card-header">
              <h2 class="section-card-title">Questions in this Test ({questions.length})</h2>
              <span class="section-card-desc">Ordered by display order / question number</span>
            </div>

            {questions.length === 0 ? (
              <div class="empty-questions">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <h3>No Questions Added Yet</h3>
                <p>Use the form on the right to add your first Section-A question (MCQ, Fill in the Blank, True/False, etc.).</p>
              </div>
            ) : (
              <div class="questions-stack">
                {questions.map((q, idx) => (
                  <div class={`question-item-card ${editingQuestion?.id === q.id ? 'active-editing' : ''}`} id={`q-${q.id}`}>
                    <div class="q-header">
                      <div class="q-header-left">
                        <span class="q-number">Q{q.question_number || idx + 1}</span>
                        <span class="q-type-badge">{q.question_type || 'mcq'}</span>
                        <span class="q-source-badge">{q.question_source || 'text'}</span>
                      </div>
                      <div class="q-header-right">
                        <span class="q-marks-badge">{q.marks} {q.marks === 1 ? 'Mark' : 'Marks'}</span>
                        
                        <!-- Order arrows -->
                        <div class="reorder-controls">
                          {idx > 0 && (
                            <form method="POST" style="display:inline;">
                              <input type="hidden" name="_action" value="move_question" />
                              <input type="hidden" name="question_id" value={q.id} />
                              <input type="hidden" name="direction" value="up" />
                              <button type="submit" class="order-btn" title="Move Up">↑</button>
                            </form>
                          )}
                          {idx < questions.length - 1 && (
                            <form method="POST" style="display:inline;">
                              <input type="hidden" name="_action" value="move_question" />
                              <input type="hidden" name="question_id" value={q.id} />
                              <input type="hidden" name="direction" value="down" />
                              <button type="submit" class="order-btn" title="Move Down">↓</button>
                            </form>
                          )}
                        </div>
                      </div>
                    </div>

                    <div class="q-body">
                      {q.question_text_english && (
                        <p class="q-text-en">{q.question_text_english}</p>
                      )}
                      {q.question_text_gujarati && (
                        <p class="q-text-gu gujarati-text">{q.question_text_gujarati}</p>
                      )}
                      {q.image_data && (
                        <div class="q-image-preview">
                          <span class="badge badge-accent">Image Question Attached</span>
                        </div>
                      )}

                      <!-- Options display for MCQ / Options -->
                      {(q.option_a || q.option_b) && (
                        <div class="q-options-grid">
                          {q.option_a && <div class={`q-opt ${q.correct_option === 'A' ? 'opt-correct' : ''}`}><span>A:</span> {q.option_a}</div>}
                          {q.option_b && <div class={`q-opt ${q.correct_option === 'B' ? 'opt-correct' : ''}`}><span>B:</span> {q.option_b}</div>}
                          {q.option_c && <div class={`q-opt ${q.correct_option === 'C' ? 'opt-correct' : ''}`}><span>C:</span> {q.option_c}</div>}
                          {q.option_d && <div class={`q-opt ${q.correct_option === 'D' ? 'opt-correct' : ''}`}><span>D:</span> {q.option_d}</div>}
                        </div>
                      )}

                      <!-- Answer indicator -->
                      {(q.correct_option || q.correct_answer_text) && (
                        <div class="q-correct-row">
                          <span class="correct-label">Correct Answer:</span>
                          <span class="correct-val">
                            {q.correct_option ? `Option ${q.correct_option}` : ''}
                            {q.correct_answer_text ? ` (${q.correct_answer_text})` : ''}
                          </span>
                        </div>
                      )}

                      {q.explanation && (
                        <p class="q-explanation"><em>Note / Explanation:</em> {q.explanation}</p>
                      )}
                    </div>

                    <div class="q-actions">
                      <a href={`/admin/tests/${testId}/questions?edit=${q.id}#questionFormCard`} class="btn btn-outline btn-sm">
                        Edit
                      </a>

                      <form method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this question?');">
                        <input type="hidden" name="_action" value="delete_question" />
                        <input type="hidden" name="question_id" value={q.id} />
                        <button type="submit" class="btn btn-sm btn-danger">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Add/Edit Form Column (Right) -->
        <div class="question-form-column" id="questionFormCard">
          <div class="card section-card sticky-form">
            <div class="section-card-header">
              <h2 class="section-card-title">{editingQuestion ? `Edit Question #${editingQuestion.question_number || ''}` : '+ Add Section-A Question'}</h2>
              <span class="section-card-desc">Configure question type, source, options, and answer</span>
              {editingQuestion && (
                <a href={`/admin/tests/${testId}/questions`} class="cancel-edit-link">✕ Cancel Edit</a>
              )}
            </div>

            <form method="POST" class="q-form">
              <input type="hidden" name="_action" value={editingQuestion ? 'update_question' : 'create_question'} />
              {editingQuestion && <input type="hidden" name="question_id" value={editingQuestion.id} />}

              <!-- Question Type & Source -->
              <div class="form-row">
                <div class="form-group">
                  <label for="question_type">Question Type *</label>
                  <select id="question_type" name="question_type" required class="form-control">
                    {SECTION_A_QUESTION_TYPES.map(t => (
                      <option value={t.key} selected={editingQuestion ? (editingQuestion.question_type === t.key) : (t.key === 'mcq')}>
                        {t.label}
                      </option>
                    ))}
                  </select>
                </div>

                <div class="form-group">
                  <label for="question_source">Question Source *</label>
                  <select id="question_source" name="question_source" required class="form-control">
                    {SECTION_A_QUESTION_SOURCES.map(s => (
                      <option value={s.key} selected={editingQuestion ? (editingQuestion.question_source === s.key) : (s.key === 'text')}>
                        {s.label}
                      </option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Question Content Textareas -->
              <div class="form-group">
                <label for="question_text_english">Question Text (English)</label>
                <textarea 
                  id="question_text_english" 
                  name="question_text_english" 
                  rows="3" 
                  placeholder="Enter question prompt in English..." 
                  class="form-control"
                >{editingQuestion ? (editingQuestion.question_text_english || '') : ''}</textarea>
              </div>

              <div class="form-group">
                <label for="question_text_gujarati">Question Text (Gujarati - optional)</label>
                <textarea 
                  id="question_text_gujarati" 
                  name="question_text_gujarati" 
                  rows="2" 
                  placeholder="ગુજરાતીમાં પ્રશ્ન લખો..." 
                  class="form-control gujarati-text"
                >{editingQuestion ? (editingQuestion.question_text_gujarati || '') : ''}</textarea>
              </div>

              <!-- Options A, B, C, D (for MCQ / Options) -->
              <div id="optionsGroup" class="options-container">
                <p class="group-subtitle">Options (for MCQ &amp; Option-based questions)</p>
                <div class="form-row">
                  <div class="form-group">
                    <label for="option_a">Option A</label>
                    <input type="text" id="option_a" name="option_a" value={editingQuestion ? (editingQuestion.option_a || '') : ''} class="form-control" placeholder="Option A text" />
                  </div>
                  <div class="form-group">
                    <label for="option_b">Option B</label>
                    <input type="text" id="option_b" name="option_b" value={editingQuestion ? (editingQuestion.option_b || '') : ''} class="form-control" placeholder="Option B text" />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label for="option_c">Option C</label>
                    <input type="text" id="option_c" name="option_c" value={editingQuestion ? (editingQuestion.option_c || '') : ''} class="form-control" placeholder="Option C text" />
                  </div>
                  <div class="form-group">
                    <label for="option_d">Option D</label>
                    <input type="text" id="option_d" name="option_d" value={editingQuestion ? (editingQuestion.option_d || '') : ''} class="form-control" placeholder="Option D text" />
                  </div>
                </div>

                <div class="form-group">
                  <label for="correct_option">Correct Option (for MCQ)</label>
                  <select id="correct_option" name="correct_option" class="form-control">
                    <option value="">Select Correct Option</option>
                    <option value="A" selected={editingQuestion ? editingQuestion.correct_option === 'A' : false}>Option A</option>
                    <option value="B" selected={editingQuestion ? editingQuestion.correct_option === 'B' : false}>Option B</option>
                    <option value="C" selected={editingQuestion ? editingQuestion.correct_option === 'C' : false}>Option C</option>
                    <option value="D" selected={editingQuestion ? editingQuestion.correct_option === 'D' : false}>Option D</option>
                  </select>
                </div>
              </div>

              <!-- Correct Answer Text (for Fill Blank, True/False, One Word, One Line) -->
              <div class="form-group" id="answerTextGroup">
                <label for="correct_answer_text">Correct Answer Text</label>
                <input 
                  type="text" 
                  id="correct_answer_text" 
                  name="correct_answer_text" 
                  placeholder="e.g. True, False, 45 m/s, ઓહ્મનો નિયમ" 
                  value={editingQuestion ? (editingQuestion.correct_answer_text || '') : ''} 
                  class="form-control" 
                />
                <span class="field-hint">Used for Fill in the Blank, True/False, One Word, or One Line answers.</span>
              </div>

              <!-- Weightage Marks & Explanation -->
              <div class="form-row">
                <div class="form-group">
                  <label for="marks">Marks *</label>
                  <input 
                    type="number" 
                    id="marks" 
                    name="marks" 
                    min="1" 
                    max="10" 
                    value={editingQuestion ? (editingQuestion.marks || 1) : 1} 
                    required 
                    class="form-control" 
                  />
                  <span class="field-hint">Default is 1 mark for Section A.</span>
                </div>

                <div class="form-group">
                  <label for="explanation">Explanation / Solution Hint (Optional)</label>
                  <input 
                    type="text" 
                    id="explanation" 
                    name="explanation" 
                    placeholder="Short hint or reason for answer" 
                    value={editingQuestion ? (editingQuestion.explanation || '') : ''} 
                    class="form-control" 
                  />
                </div>
              </div>

              <!-- Phase 2 Future Image Notice -->
              <div class="image-notice-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <span><strong>Phase 1 Note:</strong> Client-side compressed image upload for diagrams will be introduced in Phase 2. The database field <code>image_data</code> is ready.</span>
              </div>

              <!-- Form Submit Buttons -->
              <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                  {editingQuestion ? 'Update Question' : '+ Add Question'}
                </button>
                {editingQuestion && (
                  <a href={`/admin/tests/${testId}/questions`} class="btn btn-outline">Cancel</a>
                )}
              </div>
            </form>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>

