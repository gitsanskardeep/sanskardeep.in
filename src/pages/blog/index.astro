---
export const prerender = false; // Cloudflare dynamic SSR

import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPublishedBlogPosts } from '../../lib/blog';
import { SITE_INFO } from '../../data/portalData';

// Cloudflare v14 environment access pattern
let blogPostsList: Awaited<ReturnType<typeof getPublishedBlogPosts>> = [];
try {
  const { env } = await import('cloudflare:workers');
  const db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
  blogPostsList = await getPublishedBlogPosts(db);
} catch {
  // Local fallback
  blogPostsList = await getPublishedBlogPosts(undefined);
}

const title = `Educational Blog & GSEB Exam Guidance | ${SITE_INFO.name}`;
const description = `Read expert GSEB board exam strategies, paper presentation methods, subject-wise revision plans, and career guidance for Std 9 to 12 students.`;

// Extract unique categories for filter pills
const categories = Array.from(new Set(blogPostsList.map(p => p.category).filter(Boolean)));
---

<Layout title={title} description={description}>
  {/* Blog Hero Banner */}
  <section class="blog-hero">
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge">Gujarat Board (GSEB) • Exam Guidance</span>
        <h1 class="hero-title">Educational Blog & Articles</h1>
        <p class="hero-subtitle gujarati-text">"માર્ગદર્શન અને સફળતાની રણનીતિ"</p>
        <p class="hero-desc">
          Practical strategies, subject-wise blueprint analysis, time management insights, and career path guides written by experienced Gujarat Board educators.
        </p>
      </div>
    </div>
  </section>

  {/* Main Blog Directory Section */}
  <section class="section">
    <div class="container">
      {/* Category Filter Pills & Search */}
      <div class="filters-bar">
        <div class="filter-group">
          <span class="filter-label">Filter by Category:</span>
          <div class="filter-pills">
            <button class="pill active" data-filter="all">All Articles</button>
            {categories.map(cat => (
              <button class="pill" data-filter={cat.toLowerCase()}>{cat}</button>
            ))}
          </div>
        </div>

        <div class="search-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="searchInput" placeholder="Search articles, strategies, blueprints..." class="search-input" />
        </div>
      </div>

      {/* Blog Grid */}
      <div class="grid-3" id="blogGrid">
        {blogPostsList.map(post => (
          <div 
            class="blog-item-wrapper" 
            data-cat={post.category?.toLowerCase() || ''} 
            data-std={post.className?.toLowerCase() || ''}
            data-title={post.title_english.toLowerCase()}
            data-summary={post.summary?.toLowerCase() || ''}
          >
            <BlogCard post={post} variant="standard" />
          </div>
        ))}
      </div>

      {blogPostsList.length === 0 && (
        <div class="empty-state card">
          <h3>No articles found</h3>
          <p>Please check back shortly as new educational guides and strategy articles are published regularly.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    background: linear-gradient(180deg, var(--color-primary-navy) 0%, #173859 100%);
    color: #ffffff;
    padding: 3.5rem 0 4rem 0;
    border-bottom: 3px solid var(--color-accent-gold);
    text-align: center;
  }

  .hero-content {
    max-width: 780px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    background-color: rgba(217, 119, 6, 0.25);
    color: #fcd34d;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid rgba(253, 230, 138, 0.3);
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #fcd34d;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.55;
  }

  .filters-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
    background-color: var(--color-surface);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-medium);
    background-color: var(--color-bg-main);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .pill:hover, .pill.active {
    background-color: var(--color-primary-navy);
    color: #ffffff;
    border-color: var(--color-primary-navy);
  }

  .search-box {
    position: relative;
    width: 300px;
    flex-shrink: 0;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
  }

  .search-input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.25rem;
    font-size: 0.875rem;
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    outline: none;
  }

  .search-input:focus {
    border-color: var(--color-primary-blue);
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .filters-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .search-box {
      width: 100%;
    }
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterPills = document.querySelectorAll('.filter-pills .pill');
  const items = document.querySelectorAll('.blog-item-wrapper');

  let activeFilter = 'all';

  function filterItems() {
    const query = searchInput?.value.toLowerCase().trim() || '';

    items.forEach((item) => {
      const cat = item.getAttribute('data-cat') || '';
      const std = item.getAttribute('data-std') || '';
      const title = item.getAttribute('data-title') || '';
      const summary = item.getAttribute('data-summary') || '';

      const matchesFilter = activeFilter === 'all' || cat.includes(activeFilter);
      const matchesQuery = !query || 
        title.includes(query) || 
        summary.includes(query) || 
        cat.includes(query) || 
        std.includes(query);

      if (matchesFilter && matchesQuery) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = pill.getAttribute('data-filter') || 'all';
      filterItems();
    });
  });

  searchInput?.addEventListener('input', filterItems);
</script>
