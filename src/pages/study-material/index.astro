---
export const prerender = false; // Render dynamically on Cloudflare to fetch D1 records

import Layout from '../../layouts/Layout.astro';
import StudyMaterialCard from '../../components/StudyMaterialCard.astro';
import { getPublishedStudyMaterials } from '../../lib/studyMaterials';
import { SITE_INFO } from '../../data/portalData';

// @astrojs/cloudflare v14+: bindings are accessed via cloudflare:workers module
let materialsList: Awaited<ReturnType<typeof getPublishedStudyMaterials>> = [];
try {
  const { env } = await import('cloudflare:workers');
  const db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
  materialsList = await getPublishedStudyMaterials(db);
} catch {
  // Fallback for local dev without cloudflare:workers module
  materialsList = await getPublishedStudyMaterials(undefined);
}

const title = `Study Material & Chapter Revision Notes | ${SITE_INFO.name}`;
const description = `Access curated Gujarat Board (GSEB) Std 9 to 12 study notes, chapter summaries, question banks, and learning assets.`;
---

<Layout title={title} description={description}>
  {/* Hero Banner */}
  <section class="materials-hero">
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge">GSEB Curriculum • Std 9 to 12</span>
        <h1 class="hero-title">Study Material Repository</h1>
        <p class="hero-subtitle gujarati-text">"સાહિત્ય સમૂહ અને અભ્યાસ સામગ્રી"</p>
        <p class="hero-desc">
          Chapter-wise revision notes, important formulas, digests, and textbook solutions crafted specifically for Gujarat Board students.
        </p>
      </div>
    </div>
  </section>

  {/* Main Content Section */}
  <section class="section">
    <div class="container">
      {/* Category / Class Filter Pills & Search */}
      <div class="filters-bar">
        <div class="filter-group">
          <span class="filter-label">Filter by Standard:</span>
          <div class="filter-pills">
            <button class="pill active" data-filter="all">All Materials</button>
            <button class="pill" data-filter="std 9">Std 9</button>
            <button class="pill" data-filter="std 10">Std 10</button>
            <button class="pill" data-filter="std 11">Std 11</button>
            <button class="pill" data-filter="std 12">Std 12</button>
          </div>
        </div>

        <div class="search-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="searchInput" placeholder="Search chapters, topics, subjects..." class="search-input" />
        </div>
      </div>

      {/* Materials Grid */}
      <div class="grid-2" id="materialsGrid">
        {materialsList.map(item => (
          <div 
            class="material-item-wrapper" 
            data-std={item.className?.toLowerCase() || ''} 
            data-title={item.title_english.toLowerCase()}
            data-sub={item.subjectName?.toLowerCase() || ''}
            data-cat={item.categoryName?.toLowerCase() || ''}
            data-chapter={item.chapter?.toLowerCase() || ''}
          >
            <StudyMaterialCard material={item} variant="standard" />
          </div>
        ))}
      </div>

      {materialsList.length === 0 && (
        <div class="empty-state card">
          <h3>No study materials found</h3>
          <p>Please check back shortly as curated study notes and chapter assets are being uploaded.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .materials-hero {
    background: linear-gradient(180deg, var(--color-primary-navy) 0%, #173859 100%);
    color: #ffffff;
    padding: 3.5rem 0 4rem 0;
    border-bottom: 3px solid var(--color-accent-gold);
    text-align: center;
  }

  .hero-content {
    max-width: 780px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    background-color: rgba(217, 119, 6, 0.25);
    color: #fcd34d;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid rgba(253, 230, 138, 0.3);
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #fcd34d;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.55;
  }

  .filters-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
    background-color: var(--color-surface);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-medium);
    background-color: var(--color-bg-main);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all 0.15s ease;
  }

  .pill:hover, .pill.active {
    background-color: var(--color-primary-navy);
    color: #ffffff;
    border-color: var(--color-primary-navy);
  }

  .search-box {
    position: relative;
    width: 300px;
    flex-shrink: 0;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
  }

  .search-input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.25rem;
    font-size: 0.875rem;
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    outline: none;
  }

  .search-input:focus {
    border-color: var(--color-primary-blue);
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .filters-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .search-box {
      width: 100%;
    }
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterPills = document.querySelectorAll('.filter-pills .pill');
  const items = document.querySelectorAll('.material-item-wrapper');

  let activeFilter = 'all';

  function filterItems() {
    const query = searchInput?.value.toLowerCase().trim() || '';

    items.forEach((item) => {
      const std = item.getAttribute('data-std') || '';
      const title = item.getAttribute('data-title') || '';
      const sub = item.getAttribute('data-sub') || '';
      const cat = item.getAttribute('data-cat') || '';
      const chapter = item.getAttribute('data-chapter') || '';

      const matchesFilter = activeFilter === 'all' || std.includes(activeFilter);
      const matchesQuery = !query || 
        title.includes(query) || 
        std.includes(query) || 
        sub.includes(query) || 
        cat.includes(query) || 
        chapter.includes(query);

      if (matchesFilter && matchesQuery) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = pill.getAttribute('data-filter') || 'all';
      filterItems();
    });
  });

  searchInput?.addEventListener('input', filterItems);
</script>
