---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClassesSection from '../components/ClassesSection.astro';
import StudyMaterialSection from '../components/StudyMaterialSection.astro';
import TestsSection from '../components/TestsSection.astro';
import BlogSection from '../components/BlogSection.astro';
import DownloadsSection from '../components/DownloadsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import { getPublishedBlogPosts } from '../lib/blog';

let db: import('@cloudflare/workers-types').D1Database | undefined;
try {
  const { env } = await import('cloudflare:workers');
  db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
} catch {
  db = undefined;
}

const livePosts = await getPublishedBlogPosts(db);
const homeBlogPosts = livePosts.slice(0, 3);
---

<Layout>
	<Hero />
	<ClassesSection />
	<StudyMaterialSection />
	<TestsSection />
	<BlogSection posts={homeBlogPosts} />
	<DownloadsSection />
	<AboutSection />
</Layout>
