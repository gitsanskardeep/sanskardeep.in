---
export const prerender = false; // Render dynamically on Cloudflare to fetch D1 records

import Layout from '../../layouts/Layout.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import { getPublishedDownloads } from '../../lib/downloads';
import { SITE_INFO } from '../../data/portalData';

const db = Astro.locals.runtime?.env?.DB;
const downloadsList = await getPublishedDownloads(db);

const title = `Free PDF Downloads & Study Material | ${SITE_INFO.name}`;
const description = `Download Gujarat Board (GSEB) Std 9 to 12 blueprints, model question paper sets, IMP reaction charts, and syllabus copies for free.`;
---

<Layout title={title} description={description}>
  {/* Downloads Page Header Banner */}
  <section class="downloads-hero">
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge">GSEB Std 9 to 12 • 100% Free Access</span>
        <h1 class="hero-title">Educational PDF Library</h1>
        <p class="hero-subtitle gujarati-text">"{SITE_INFO.taglineGujarati}"</p>
        <p class="hero-desc">
          Official Gujarat Board syllabus copies, chapter blueprints, model question paper sets, handwritten formula charts, and IMP question banks.
        </p>
      </div>
    </div>
  </section>

  {/* Main Downloads Directory Section */}
  <section class="section">
    <div class="container">
      {/* Category / Class Filter Pills */}
      <div class="filters-bar">
        <div class="filter-group">
          <span class="filter-label">Filter by Standard:</span>
          <div class="filter-pills">
            <button class="pill active" data-filter="all">All Downloads</button>
            <button class="pill" data-filter="std 9">Std 9</button>
            <button class="pill" data-filter="std 10">Std 10</button>
            <button class="pill" data-filter="std 11">Std 11</button>
            <button class="pill" data-filter="std 12">Std 12</button>
          </div>
        </div>

        <div class="search-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="searchInput" placeholder="Search papers, blueprints, subjects..." class="search-input" />
        </div>
      </div>

      {/* Downloads Grid */}
      <div class="grid-2" id="downloadsGrid">
        {downloadsList.map(item => (
          <div class="download-item-wrapper" data-std={item.className?.toLowerCase() || ''} data-title={item.title.toLowerCase()}>
            <DownloadCard download={item} variant="standard" />
          </div>
        ))}
      </div>

      {downloadsList.length === 0 && (
        <div class="empty-state card">
          <h3>No PDF documents found</h3>
          <p>Please check back later as new GSEB model papers and study notes are added regularly.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .downloads-hero {
    background: linear-gradient(180deg, var(--color-primary-navy) 0%, #173859 100%);
    color: #ffffff;
    padding: 3.5rem 0 4rem 0;
    border-bottom: 3px solid var(--color-accent-gold);
    text-align: center;
  }

  .hero-content {
    max-width: 780px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    background-color: rgba(217, 119, 6, 0.25);
    color: #fcd34d;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid rgba(253, 230, 138, 0.3);
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #fcd34d;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.55;
  }

  .filters-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
    background-color: var(--color-surface);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-medium);
    background-color: var(--color-bg-main);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all 0.15s ease;
  }

  .pill:hover, .pill.active {
    background-color: var(--color-primary-navy);
    color: #ffffff;
    border-color: var(--color-primary-navy);
  }

  .search-box {
    position: relative;
    width: 300px;
    flex-shrink: 0;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
  }

  .search-input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.25rem;
    font-size: 0.875rem;
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    outline: none;
  }

  .search-input:focus {
    border-color: var(--color-primary-blue);
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .filters-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .search-box {
      width: 100%;
    }
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<script>
  // Simple client-side search & filter logic
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterPills = document.querySelectorAll('.filter-pills .pill');
  const items = document.querySelectorAll('.download-item-wrapper');

  let activeFilter = 'all';

  function filterItems() {
    const query = searchInput?.value.toLowerCase().trim() || '';

    items.forEach((item) => {
      const std = item.getAttribute('data-std') || '';
      const title = item.getAttribute('data-title') || '';

      const matchesFilter = activeFilter === 'all' || std.includes(activeFilter);
      const matchesQuery = !query || title.includes(query) || std.includes(query);

      if (matchesFilter && matchesQuery) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = pill.getAttribute('data-filter') || 'all';
      filterItems();
    });
  });

  searchInput?.addEventListener('input', filterItems);
</script>
