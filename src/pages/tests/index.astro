---
export const prerender = false; // Render dynamically on Cloudflare to fetch D1 records

import Layout from '../../layouts/Layout.astro';
import TestCard from '../../components/TestCard.astro';
import { getPublishedTests } from '../../lib/tests';
import { SITE_INFO } from '../../data/portalData';

// @astrojs/cloudflare v14+: bindings accessed via cloudflare:workers module
let testsList: Awaited<ReturnType<typeof getPublishedTests>> = [];
try {
  const { env } = await import('cloudflare:workers');
  const db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
  testsList = await getPublishedTests(db);
} catch {
  // Fallback for local dev without cloudflare:workers module
  testsList = await getPublishedTests(undefined);
}

// Build filter options dynamically from live data
const classOptions = [...new Set(testsList.map(t => t.className).filter(Boolean))] as string[];
const typeOptions  = [...new Set(testsList.map(t => t.test_type).filter(Boolean))] as string[];

const title = `Tests & Practice Papers | ${SITE_INFO.name}`;
const description = `Free GSEB unit test papers, board model question papers, chapter quizzes, MCQ practice sets, and revision tests for Std 9, 10, 11, and 12 Gujarat Board students.`;
---

<Layout title={title} description={description}>
  <!-- Page Hero -->
  <section class="tp-hero">
    <div class="container">
      <div class="tp-hero-inner">
        <span class="tp-hero-badge">GSEB Std 9–12 • Practice &amp; Evaluate • ટેસ્ટ શ્રેણી</span>
        <h1 class="tp-hero-title">Tests &amp; Practice Papers</h1>
        <p class="tp-hero-gujarati gujarati-text">"{SITE_INFO.taglineGujarati}"</p>
        <p class="tp-hero-desc">
          Unit test papers, chapter quizzes, MCQ practice sets, and full 100-mark Gujarat Board model exam papers — all free.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Section -->
  <section class="section">
    <div class="container">

      <!-- Filters (only when tests exist) -->
      {testsList.length > 0 && (
        <div class="tp-filters" role="search" aria-label="Filter tests">
          <div class="tp-filter-rows">
            <!-- Standard filter -->
            <div class="tp-filter-row">
              <span class="tp-filter-label" id="class-filter-label">Standard</span>
              <div class="tp-pills" id="classFilterPills" role="group" aria-labelledby="class-filter-label">
                <button class="tp-pill active" data-filter-class="all">All</button>
                {classOptions.map(cls => (
                  <button class="tp-pill" data-filter-class={cls.toLowerCase()}>{cls}</button>
                ))}
              </div>
            </div>

            <!-- Test type filter (only when multiple types) -->
            {typeOptions.length > 1 && (
              <div class="tp-filter-row">
                <span class="tp-filter-label" id="type-filter-label">Type</span>
                <div class="tp-pills" id="typeFilterPills" role="group" aria-labelledby="type-filter-label">
                  <button class="tp-pill active" data-filter-type="all">All Types</button>
                  {typeOptions.map(t => (
                    <button class="tp-pill" data-filter-type={t.toLowerCase()}>{t}</button>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Search -->
          <div class="tp-search">
            <label for="searchInput" class="sr-only">Search tests</label>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tp-search-icon" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="searchInput"
              placeholder="Search title, subject, chapter…"
              class="tp-search-input"
              autocomplete="off"
            />
          </div>
        </div>
      )}

      <!-- Test Cards Grid -->
      {testsList.length > 0 ? (
        <div class="grid-2 tp-grid" id="testsGrid">
          {testsList.map(item => (
            <div
              class="test-item-wrapper"
              data-class={(item.className || '').toLowerCase()}
              data-type={(item.test_type || '').toLowerCase()}
              data-title={item.title.toLowerCase()}
              data-subject={(item.subjectName || '').toLowerCase()}
              data-chapter={(item.chapter || '').toLowerCase()}
            >
              <TestCard test={item} />
            </div>
          ))}
        </div>
      ) : (
        <div class="tp-empty">
          <div class="tp-empty-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <h2 class="tp-empty-title">No Tests Available Yet</h2>
          <p class="tp-empty-desc">New test papers and practice materials will be added soon.</p>
        </div>
      )}

      <!-- No-results message (shown by JS when filters produce zero results) -->
      <div id="noFilterResults" class="tp-empty tp-no-results" style="display: none;" aria-live="polite">
        <p class="tp-empty-title" style="font-size: 1.1rem;">No matching tests</p>
        <p class="tp-empty-desc">Try a different standard, type, or clear the search.</p>
      </div>

    </div>
  </section>
</Layout>

<script>
  function setupFilters() {
    const classPills  = document.querySelectorAll<HTMLButtonElement>('[data-filter-class]');
    const typePills   = document.querySelectorAll<HTMLButtonElement>('[data-filter-type]');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const wrappers    = document.querySelectorAll<HTMLElement>('.test-item-wrapper');
    const noResults   = document.getElementById('noFilterResults');

    let activeClass = 'all';
    let activeType  = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visible = 0;
      wrappers.forEach(el => {
        const cls     = el.getAttribute('data-class')   || '';
        const type    = el.getAttribute('data-type')    || '';
        const title   = el.getAttribute('data-title')   || '';
        const subject = el.getAttribute('data-subject') || '';
        const chapter = el.getAttribute('data-chapter') || '';

        const matchClass  = activeClass === 'all' || cls.includes(activeClass);
        const matchType   = activeType  === 'all' || type.includes(activeType);
        const matchSearch = !searchQuery ||
          title.includes(searchQuery)   ||
          subject.includes(searchQuery) ||
          chapter.includes(searchQuery);

        const show = matchClass && matchType && matchSearch;
        el.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (noResults) {
        noResults.style.display = (visible === 0 && wrappers.length > 0) ? 'block' : 'none';
      }
    }

    classPills.forEach(btn => {
      btn.addEventListener('click', () => {
        classPills.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeClass = btn.getAttribute('data-filter-class') || 'all';
        applyFilters();
      });
    });

    typePills.forEach(btn => {
      btn.addEventListener('click', () => {
        typePills.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeType = btn.getAttribute('data-filter-type') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').toLowerCase().trim();
      applyFilters();
    });
  }

  document.addEventListener('DOMContentLoaded', setupFilters);
  setupFilters();
</script>

<style>
  /* ─────────────────────────────────────────
     Hero
  ───────────────────────────────────────── */
  .tp-hero {
    background-color: var(--color-primary-navy);
    color: #ffffff;
    padding: 3.25rem 0 3.75rem;
    border-bottom: 3px solid var(--color-accent-gold);
    text-align: center;
  }

  .tp-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .tp-hero-badge {
    display: inline-block;
    background-color: rgba(217, 119, 6, 0.22);
    color: #fcd34d;
    padding: 0.28rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    margin-bottom: 1rem;
    border: 1px solid rgba(253, 230, 138, 0.28);
  }

  .tp-hero-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
    line-height: 1.15;
  }

  .tp-hero-gujarati {
    font-size: 1.05rem;
    color: #fde68a;
    font-style: italic;
    margin-bottom: 0.9rem;
  }

  .tp-hero-desc {
    font-size: 1rem;
    color: #cbd5e1;
    line-height: 1.65;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ─────────────────────────────────────────
     Filters
  ───────────────────────────────────────── */
  .tp-filters {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem;
    margin-bottom: 2rem;
  }

  .tp-filter-rows {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .tp-filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tp-filter-label {
    font-size: 0.73rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    min-width: 56px;
  }

  .tp-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tp-pill {
    padding: 0.28rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-border);
    background-color: var(--color-bg-main);
    color: var(--color-text-medium);
    cursor: pointer;
    transition: all 0.18s ease;
    line-height: 1.4;
  }

  .tp-pill:hover {
    border-color: var(--color-primary-blue);
    color: var(--color-primary-blue);
    background-color: #eff6ff;
  }

  .tp-pill.active {
    background-color: var(--color-primary-navy);
    color: #ffffff;
    border-color: var(--color-primary-navy);
  }

  .tp-pill:focus-visible {
    outline: 3px solid var(--color-accent-gold);
    outline-offset: 2px;
  }

  /* Search */
  .tp-search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .tp-search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--color-text-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  .tp-search-input {
    width: 100%;
    max-width: 400px;
    padding: 0.5rem 0.85rem 0.5rem 2.35rem;
    font-size: 0.875rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-main);
    color: var(--color-text-dark);
    font-family: inherit;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .tp-search-input:focus {
    outline: none;
    border-color: var(--color-primary-blue);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    background-color: var(--color-surface);
  }

  /* ─────────────────────────────────────────
     Grid spacing tweak
  ───────────────────────────────────────── */
  .tp-grid {
    align-items: stretch;
  }

  .test-item-wrapper {
    display: flex;
    flex-direction: column;
  }

  .test-item-wrapper > * {
    flex: 1;
  }

  /* ─────────────────────────────────────────
     Empty / No Results
  ───────────────────────────────────────── */
  .tp-empty {
    text-align: center;
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .tp-empty-icon {
    width: 72px;
    height: 72px;
    background-color: #f1f5f9;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    margin-bottom: 0.25rem;
    flex-shrink: 0;
  }

  .tp-empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    margin: 0;
  }

  .tp-empty-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    max-width: 380px;
  }

  .tp-no-results {
    padding: 2.5rem 1rem;
  }

  /* ─────────────────────────────────────────
     Screen reader only utility
  ───────────────────────────────────────── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ─────────────────────────────────────────
     Responsive
  ───────────────────────────────────────── */
  @media (max-width: 768px) {
    .tp-hero-title {
      font-size: 1.85rem;
    }

    .tp-filter-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .tp-filter-label {
      min-width: unset;
    }

    .tp-search-input {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .tp-hero {
      padding: 2.5rem 0 3rem;
    }

    .tp-hero-title {
      font-size: 1.6rem;
    }

    .tp-filters {
      padding: 1rem;
    }
  }
</style>
