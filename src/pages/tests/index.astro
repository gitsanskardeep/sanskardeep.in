---
export const prerender = false; // Render dynamically on Cloudflare to fetch D1 records

import Layout from '../../layouts/Layout.astro';
import TestCard from '../../components/TestCard.astro';
import { getPublishedTests } from '../../lib/tests';
import { SITE_INFO } from '../../data/portalData';

// @astrojs/cloudflare v14+: bindings accessed via cloudflare:workers module
let testsList: Awaited<ReturnType<typeof getPublishedTests>> = [];
try {
  const { env } = await import('cloudflare:workers');
  const db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
  testsList = await getPublishedTests(db);
} catch {
  // Fallback for local dev without cloudflare:workers module
  testsList = await getPublishedTests(undefined);
}

// Build filter options dynamically from live data
const classOptions = [...new Set(testsList.map(t => t.className).filter(Boolean))] as string[];
const typeOptions = [...new Set(testsList.map(t => t.test_type).filter(Boolean))] as string[];

const title = `Tests & Practice Papers | ${SITE_INFO.name}`;
const description = `Free GSEB unit test papers, board model question papers, chapter quizzes, MCQ practice sets, and revision tests for Std 9, 10, 11, and 12 Gujarat Board students.`;
---

<Layout title={title} description={description}>
  <!-- Page Hero -->
  <section class="tests-hero">
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge">GSEB Std 9–12 • Practice & Evaluate • ટેસ્ટ શ્રેણી</span>
        <h1 class="hero-title">Tests & Practice Papers</h1>
        <p class="hero-subtitle gujarati-text">"{SITE_INFO.taglineGujarati}"</p>
        <p class="hero-desc">
          Unit test papers, chapter quizzes, MCQ practice sets, and full 100-mark Gujarat Board model exam papers — all free.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Directory Section -->
  <section class="section">
    <div class="container">
      <!-- Filters Bar -->
      {testsList.length > 0 && (
        <div class="filters-bar">
          <!-- Standard pills -->
          <div class="filter-group">
            <span class="filter-label">Standard:</span>
            <div class="filter-pills" id="classFilterPills">
              <button class="pill active" data-filter-class="all">All Classes</button>
              {classOptions.map(cls => (
                <button class="pill" data-filter-class={cls.toLowerCase()}>{cls}</button>
              ))}
            </div>
          </div>

          <!-- Type pills -->
          {typeOptions.length > 1 && (
            <div class="filter-group">
              <span class="filter-label">Type:</span>
              <div class="filter-pills" id="typeFilterPills">
                <button class="pill active" data-filter-type="all">All Types</button>
                {typeOptions.map(t => (
                  <button class="pill" data-filter-type={t.toLowerCase()}>{t}</button>
                ))}
              </div>
            </div>
          )}

          <!-- Search -->
          <div class="search-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="searchInput" placeholder="Search by title, subject, chapter..." class="search-input" />
          </div>
        </div>
      )}

      <!-- Tests Grid -->
      <div class="grid-2" id="testsGrid">
        {testsList.map(item => (
          <div
            class="test-item-wrapper"
            data-class={(item.className || '').toLowerCase()}
            data-type={(item.test_type || '').toLowerCase()}
            data-title={item.title.toLowerCase()}
            data-subject={(item.subjectName || '').toLowerCase()}
            data-chapter={(item.chapter || '').toLowerCase()}
          >
            <TestCard test={item} />
          </div>
        ))}
      </div>

      {testsList.length === 0 && (
        <div class="empty-state card">
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <h3>No Tests Available Yet</h3>
          <p>New test papers and practice materials will be added soon.</p>
        </div>
      )}

      <div id="noFilterResults" class="empty-state card" style="display: none;">
        <h3>No tests match your filters</h3>
        <p>Try selecting a different class, test type, or clearing the search box.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupFilters() {
    const classPills = document.querySelectorAll<HTMLButtonElement>('[data-filter-class]');
    const typePills = document.querySelectorAll<HTMLButtonElement>('[data-filter-type]');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const wrappers = document.querySelectorAll<HTMLElement>('.test-item-wrapper');
    const noResults = document.getElementById('noFilterResults');

    let activeClass = 'all';
    let activeType = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visible = 0;
      wrappers.forEach(el => {
        const cls = el.getAttribute('data-class') || '';
        const type = el.getAttribute('data-type') || '';
        const title = el.getAttribute('data-title') || '';
        const subject = el.getAttribute('data-subject') || '';
        const chapter = el.getAttribute('data-chapter') || '';

        const matchClass = activeClass === 'all' || cls.includes(activeClass);
        const matchType = activeType === 'all' || type.includes(activeType);
        const matchSearch = !searchQuery || 
          title.includes(searchQuery) || 
          subject.includes(searchQuery) || 
          chapter.includes(searchQuery);

        if (matchClass && matchType && matchSearch) {
          el.style.display = '';
          visible++;
        } else {
          el.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = (visible === 0 && wrappers.length > 0) ? 'block' : 'none';
      }
    }

    classPills.forEach(btn => {
      btn.addEventListener('click', () => {
        classPills.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeClass = btn.getAttribute('data-filter-class') || 'all';
        applyFilters();
      });
    });

    typePills.forEach(btn => {
      btn.addEventListener('click', () => {
        typePills.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeType = btn.getAttribute('data-filter-type') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').toLowerCase().trim();
      applyFilters();
    });
  }

  document.addEventListener('DOMContentLoaded', setupFilters);
  setupFilters();
</script>

<style>
  .tests-hero {
    background: linear-gradient(180deg, var(--color-primary-navy) 0%, #173859 100%);
    color: #ffffff;
    padding: 3.5rem 0 4rem;
    border-bottom: 3px solid var(--color-accent-gold);
    text-align: center;
  }

  .hero-content {
    max-width: 780px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    background-color: rgba(217, 119, 6, 0.25);
    color: #fcd34d;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid rgba(253, 230, 138, 0.3);
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: #fde68a;
    margin-bottom: 1rem;
    font-style: italic;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #cbd5e1;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* Filters Bar */
  .filters-bar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem 1.5rem;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .filter-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pill {
    padding: 0.3rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background-color: #f8fafc;
    color: var(--color-text-medium);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill:hover {
    border-color: var(--color-primary-blue);
    color: var(--color-primary-blue);
  }

  .pill.active {
    background-color: var(--color-primary-navy);
    color: #ffffff;
    border-color: var(--color-primary-navy);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .search-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    max-width: 420px;
    padding: 0.5rem 0.85rem;
    font-size: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: #ffffff;
    color: var(--color-text-dark);
    transition: border-color 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary-blue);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-muted);
  }

  .empty-icon {
    margin: 0 auto 1.5rem;
    width: 72px;
    height: 72px;
    background-color: #f1f5f9;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
  }

  .empty-state h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-dark);
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 1.9rem;
    }
    .filter-group {
      flex-direction: column;
      align-items: flex-start;
    }
    .search-input {
      max-width: 100%;
      width: 100%;
    }
  }
</style>
