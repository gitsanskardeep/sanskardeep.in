---
import type { TestRecord } from '../../db/schema';
import { TEST_TYPES, DIFFICULTY_LEVELS, MEDIUM_OPTIONS } from '../../lib/tests';

interface Props {
  editItem?: TestRecord | null;
  classesList?: any[];
  subjectsList?: any[];
  cancelUrl?: string;
}

const { 
  editItem = null, 
  classesList = [], 
  subjectsList = [], 
  cancelUrl = '/admin/tests' 
} = Astro.props;

const isEdit = Boolean(editItem && editItem.id);
---

<form method="POST" class="admin-form">
  <input type="hidden" name="_action" value={isEdit ? 'update' : 'create'} />
  {isEdit && <input type="hidden" name="id" value={editItem!.id} />}

  <!-- Basic Information Section -->
  <div class="form-section-card">
    <h3 class="section-heading">Basic Test Information</h3>

    <div class="form-group">
      <label for="title">Test Title *</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        required 
        placeholder="e.g. Std 10 Maths Basic & Standard - Chapter 1 to 5 Unit Test" 
        value={editItem ? editItem.title : ''} 
        class="form-control" 
      />
    </div>

    <div class="form-row-3">
      <div class="form-group">
        <label for="class_id">Standard / Class *</label>
        <select id="class_id" name="class_id" required class="form-control">
          <option value="">Select Standard / Class</option>
          {classesList.map(c => (
            <option value={c.id} selected={editItem ? editItem.class_id === c.id : false}>
              {c.title_english}
            </option>
          ))}
        </select>
      </div>

      <div class="form-group">
        <label for="subject_name">Subject</label>
        <input 
          type="text" 
          id="subject_name" 
          name="subject_name" 
          list="subjectsListSuggestions" 
          placeholder="e.g. Mathematics, Science" 
          value={editItem ? (editItem.subjectName || '') : ''} 
          class="form-control" 
        />
        <datalist id="subjectsListSuggestions">
          <option value="Mathematics" />
          <option value="Science" />
          <option value="Social Science" />
          <option value="Physics" />
          <option value="Chemistry" />
          <option value="Biology" />
          <option value="Accountancy" />
          <option value="Statistics" />
          <option value="Economics" />
          <option value="English" />
          <option value="Gujarati" />
          <option value="Sanskrit" />
          <option value="Computer Studies" />
          {subjectsList.map(s => (
            <option value={s.name_english} />
          ))}
        </datalist>
      </div>

      <div class="form-group">
        <label for="chapter">Chapter / Topic</label>
        <input 
          type="text" 
          id="chapter" 
          name="chapter" 
          placeholder="e.g. Chapter 1-5, Thermodynamics, Section A" 
          value={editItem ? (editItem.chapter || '') : ''} 
          class="form-control" 
        />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="test_type">Test Type *</label>
        <select id="test_type" name="test_type" required class="form-control">
          {TEST_TYPES.map(t => (
            <option value={t} selected={editItem ? editItem.test_type === t : t === 'Question Paper'}>
              {t}
            </option>
          ))}
        </select>
      </div>

      <div class="form-group">
        <label for="medium">Medium</label>
        <select id="medium" name="medium" class="form-control">
          {MEDIUM_OPTIONS.map(m => (
            <option value={m} selected={editItem ? editItem.medium === m : m === 'Gujarati'}>
              {m} Medium
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="description">Description / Instructions</label>
      <textarea 
        id="description" 
        name="description" 
        rows="3" 
        placeholder="Brief description of the test, syllabus coverage, or instructions for students..." 
        class="form-control"
      >{editItem ? (editItem.description || '') : ''}</textarea>
    </div>
  </div>

  <!-- Test Details Section -->
  <div class="form-section-card">
    <h3 class="section-heading">Test Parameters & Weightage</h3>

    <div class="form-row-4">
      <div class="form-group">
        <label for="total_marks">Total Marks *</label>
        <input 
          type="number" 
          id="total_marks" 
          name="total_marks" 
          required 
          min="1" 
          max="500" 
          placeholder="50" 
          value={editItem ? editItem.total_marks : 50} 
          class="form-control" 
        />
      </div>

      <div class="form-group">
        <label for="duration_minutes">Duration (Minutes) *</label>
        <input 
          type="number" 
          id="duration_minutes" 
          name="duration_minutes" 
          required 
          min="1" 
          max="360" 
          placeholder="60" 
          value={editItem ? editItem.duration_minutes : 60} 
          class="form-control" 
        />
        <span class="field-hint">e.g. 60 = 1 hour, 180 = 3 hours</span>
      </div>

      <div class="form-group">
        <label for="difficulty">Difficulty Level</label>
        <select id="difficulty" name="difficulty" class="form-control">
          {DIFFICULTY_LEVELS.map(d => (
            <option value={d} selected={editItem ? editItem.difficulty === d : d === 'Medium'}>
              {d}
            </option>
          ))}
        </select>
      </div>

      <div class="form-group">
        <label for="display_order">Display Order Index</label>
        <input 
          type="number" 
          id="display_order" 
          name="display_order" 
          value={editItem ? editItem.display_order : 1} 
          min="0" 
          class="form-control" 
        />
        <span class="field-hint">Lower numbers appear first</span>
      </div>
    </div>
  </div>

  <!-- PDF Resource Section -->
  <div class="form-section-card">
    <h3 class="section-heading">Test Paper Document (PDF)</h3>

    <div class="form-group">
      <label for="external_url">External PDF URL (Google Drive / Cloud Document Link)</label>
      <input 
        type="url" 
        id="external_url" 
        name="external_url" 
        placeholder="https://drive.google.com/file/d/..." 
        value={editItem ? (editItem.external_url || '') : ''} 
        class="form-control" 
      />
      <span class="field-hint">
        Paste full public view/share link from Google Drive or OneDrive. (Required to publish test; optional for drafts.)
      </span>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="download_url">Direct PDF Download Link (Optional)</label>
        <input 
          type="url" 
          id="download_url" 
          name="download_url" 
          placeholder="https://... direct link for instant download" 
          value={editItem ? (editItem.download_url || '') : ''} 
          class="form-control" 
        />
      </div>

      <div class="form-group">
        <label for="thumbnail_url">Thumbnail / Cover Image URL (Optional)</label>
        <input 
          type="url" 
          id="thumbnail_url" 
          name="thumbnail_url" 
          placeholder="https://... image preview" 
          value={editItem ? (editItem.thumbnail_url || '') : ''} 
          class="form-control" 
        />
      </div>
    </div>
  </div>

  <!-- Publication Settings -->
  <div class="form-section-card">
    <h3 class="section-heading">Publication Settings</h3>

    <div class="form-row">
      <div class="form-group">
        <label for="status">Publication Status</label>
        <select id="status" name="status" class="form-control">
          <option value="published" selected={editItem ? editItem.status === 'published' : true}>
            Published (Publicly Visible on /tests & Home)
          </option>
          <option value="draft" selected={editItem ? editItem.status === 'draft' : false}>
            Draft (Internal / Hidden from Public)
          </option>
        </select>
        <span class="field-hint">Published tests require an External PDF URL.</span>
      </div>
    </div>
  </div>

  <!-- Form Actions Bar -->
  <div class="form-actions-bar">
    <button type="submit" class="btn btn-primary submit-btn">
      <span>{isEdit ? 'Update Test Record' : 'Save & Publish Test Paper'}</span>
    </button>
    <a href={cancelUrl} class="btn btn-outline cancel-btn">
      Cancel
    </a>
  </div>
</form>

<style>
  .admin-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-section-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .section-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
    margin: 0;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .form-row-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .form-row-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-medium);
  }

  .form-control {
    padding: 0.65rem 0.85rem;
    font-size: 0.9rem;
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: #ffffff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--color-primary-blue);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .form-actions-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .submit-btn {
    min-width: 200px;
  }

  .cancel-btn {
    color: var(--color-text-medium);
  }

  @media (max-width: 900px) {
    .form-row-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .form-row, .form-row-3, .form-row-4 {
      grid-template-columns: 1fr;
    }
    .form-actions-bar {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .submit-btn, .cancel-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
