---
import type { BlogPostRecord } from '../../db/schema';
import BlogRichEditor from '../BlogRichEditor.astro';

interface Props {
  editItem?: BlogPostRecord | null;
  classesList?: any[];
  categoriesList?: any[];
  cancelUrl?: string;
}

const { 
  editItem = null, 
  classesList = [], 
  categoriesList = [], 
  cancelUrl = '/admin/blog' 
} = Astro.props;

const isEdit = Boolean(editItem && editItem.id);
---

<form method="POST" class="admin-form">
  <input type="hidden" name="_action" value={isEdit ? 'update' : 'create'} />
  {isEdit && <input type="hidden" name="id" value={editItem!.id} />}

  <div class="form-row">
    <div class="form-group">
      <label for="title_english">Title (English) *</label>
      <input 
        type="text" 
        id="title_english" 
        name="title_english" 
        required 
        placeholder="e.g. How to Score 90%+ in GSEB Std 10 Board Exams" 
        value={editItem ? editItem.title_english : ''} 
        class="form-control" 
      />
    </div>

    <div class="form-group">
      <label for="title_gujarati">Title (Gujarati - Optional)</label>
      <input 
        type="text" 
        id="title_gujarati" 
        name="title_gujarati" 
        placeholder="e.g. ધોરણ ૧૦ બોર્ડ પરીક્ષામાં ૯૦% થી વધુ માર્ક્સ મેળવવાની સરળ રીત" 
        value={editItem ? (editItem.title_gujarati || '') : ''} 
        class="form-control gujarati-text" 
      />
    </div>
  </div>

  <div class="form-row-3">
    <div class="form-group">
      <label for="slug">URL Slug (Auto-generated if blank)</label>
      <input 
        type="text" 
        id="slug" 
        name="slug" 
        placeholder="e.g. how-to-score-90-gseb-std-10" 
        value={editItem ? editItem.slug : ''} 
        class="form-control" 
      />
    </div>

    <div class="form-group">
      <label for="category">Category Label *</label>
      <input 
        type="text" 
        id="category" 
        name="category" 
        list="categorySuggestions" 
        required 
        placeholder="e.g. Exam Strategy" 
        value={editItem ? editItem.category : 'Exam Strategy'} 
        class="form-control" 
      />
      <datalist id="categorySuggestions">
        <option value="Exam Strategy" />
        <option value="Paper Presentation" />
        <option value="Career Guidance" />
        <option value="Blueprint Analysis" />
        <option value="Time Management" />
        <option value="Revision Tips" />
        {categoriesList.map(c => <option value={c.title_english} />)}
      </datalist>
    </div>

    <div class="form-group">
      <label for="class_id">Class Tag (Optional)</label>
      <select id="class_id" name="class_id" class="form-control">
        <option value="">-- All Classes / General --</option>
        {classesList.map(c => (
          <option value={c.id} selected={editItem ? editItem.class_id === c.id : false}>
            {c.title_english} ({c.title_gujarati})
          </option>
        ))}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label for="summary">Short Summary (Featured Snippet) *</label>
    <textarea 
      id="summary" 
      name="summary" 
      rows="3" 
      required 
      placeholder="A concise 1-2 sentence overview shown on blog cards and search engines..." 
      class="form-control"
    >{editItem ? editItem.summary : ''}</textarea>
  </div>

  <div class="form-group">
    <label>Full Article Content (Visual Rich Text & Mathematics) *</label>
    <BlogRichEditor 
      initialRichContent={editItem?.content_rich}
      initialMarkdown={editItem?.content_markdown}
    />
  </div>

  <div class="form-group">
    <label for="thumbnail_url">Featured Thumbnail Image URL (Optional)</label>
    <input 
      type="url" 
      id="thumbnail_url" 
      name="thumbnail_url" 
      placeholder="https://example.com/blog-thumbnail.jpg (leave empty for category default)" 
      value={editItem ? (editItem.thumbnail_url || '') : ''} 
      class="form-control" 
    />
  </div>

  <div class="form-row-3">
    <div class="form-group">
      <label for="read_time">Estimated Read Time</label>
      <input 
        type="text" 
        id="read_time" 
        name="read_time" 
        placeholder="e.g. 5 min read" 
        value={editItem ? (editItem.read_time || '5 min read') : '5 min read'} 
        class="form-control" 
      />
    </div>

    <div class="form-group">
      <label for="published_at">Publish Date (YYYY-MM-DD)</label>
      <input 
        type="date" 
        id="published_at" 
        name="published_at" 
        value={editItem ? (editItem.published_at ? editItem.published_at.slice(0, 10) : new Date().toISOString().slice(0, 10)) : new Date().toISOString().slice(0, 10)} 
        class="form-control" 
      />
    </div>

    <div class="form-group">
      <label for="status">Status</label>
      <select id="status" name="status" class="form-control">
        <option value="published" selected={editItem ? editItem.status === 'published' : true}>Published (Public)</option>
        <option value="draft" selected={editItem ? editItem.status === 'draft' : false}>Draft (Hidden)</option>
      </select>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="display_order">Display Order Index</label>
      <input 
        type="number" 
        id="display_order" 
        name="display_order" 
        value={editItem ? editItem.display_order : 1} 
        min="0" 
        class="form-control" 
      />
      <span class="field-hint">Lower numbers appear first on the blog page.</span>
    </div>
  </div>

  <div class="form-actions-bar">
    <button type="submit" class="btn btn-primary submit-btn">
      <span>{isEdit ? 'Update Article' : 'Save & Publish Article'}</span>
    </button>
    <a href={cancelUrl} class="btn btn-outline cancel-btn">
      Cancel
    </a>
  </div>
</form>

<script>
  // Automatic slug generator from English title if slug field is empty
  const titleInput = document.getElementById('title_english') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;

  if (titleInput && slugInput) {
    let slugManuallyEdited = Boolean(slugInput.value);
    slugInput.addEventListener('input', () => {
      slugManuallyEdited = Boolean(slugInput.value.trim());
    });

    titleInput.addEventListener('input', () => {
      if (!slugManuallyEdited) {
        const generated = titleInput.value
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
        slugInput.value = generated;
      }
    });
  }
</script>

<style>
  .admin-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .form-row-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-medium);
  }

  .form-control {
    padding: 0.65rem 0.85rem;
    font-size: 0.9rem;
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: #ffffff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--color-primary-blue);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .form-actions-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .submit-btn {
    min-width: 180px;
  }

  .cancel-btn {
    color: var(--color-text-medium);
  }

  @media (max-width: 768px) {
    .form-row, .form-row-3 {
      grid-template-columns: 1fr;
    }
    .form-actions-bar {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .submit-btn, .cancel-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
