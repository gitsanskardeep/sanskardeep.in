---
import type { StudyMaterialRecord } from '../db/schema';

interface Props {
  material: StudyMaterialRecord;
  variant?: 'standard' | 'featured' | 'compact';
}

const { material, variant = 'standard' } = Astro.props;

// Format file size or fallback label
function formatBytes(bytes: number): string {
  if (!bytes || bytes === 0) return 'Study Material';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}

const formattedSize = formatBytes(material.file_size_bytes);
const targetUrl = material.external_url || material.download_url || '#';
---

<div class={`card material-card-item variant-${variant}`}>
  {/* Card Header Badges */}
  <div class="card-top">
    <div class="badge-group">
      {material.className && <span class="badge badge-accent">{material.className}</span>}
      {material.subjectName && <span class="badge badge-primary">{material.subjectName}</span>}
      {material.categoryName && <span class="badge badge-category">{material.categoryName}</span>}
      {material.chapter && <span class="badge badge-chapter">{material.chapter}</span>}
    </div>
    {material.badge && <span class="custom-badge">{material.badge}</span>}
  </div>

  {/* Main Content Body */}
  <div class="card-body">
    <div class="icon-container">
      {material.thumbnail_url ? (
        <img src={material.thumbnail_url} alt={material.title_english} class="thumbnail-img" />
      ) : (
        <div class="doc-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </div>
      )}
    </div>

    <div class="details-container">
      <h3 class="material-card-title">{material.title_english}</h3>
      {material.title_gujarati && (
        <div class="material-title-gujarati gujarati-text">{material.title_gujarati}</div>
      )}
      {material.description && <p class="material-desc">{material.description}</p>}
    </div>
  </div>

  {/* Card Footer Actions & Meta */}
  <div class="card-footer">
    <div class="meta-info">
      <span class="size-meta">{formattedSize}</span>
      {material.download_count > 0 && (
        <span class="downloads-meta">{material.download_count.toLocaleString()}+ views</span>
      )}
    </div>

    <a 
      href={targetUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="btn btn-sm btn-primary action-btn"
      aria-label={`View material for ${material.title_english}`}
    >
      <span>Open Study Material</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>
</div>

<style>
  .material-card-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-top: 3px solid var(--color-primary-navy);
    background-color: var(--color-surface);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .material-card-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 0.5rem;
  }

  .badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge-category {
    background-color: #f1f5f9;
    color: var(--color-text-medium);
    border: 1px solid var(--color-border);
  }

  .badge-chapter {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
  }

  .custom-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-primary-blue);
    background-color: #eff6ff;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    border: 1px solid #bfdbfe;
  }

  .card-body {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .icon-container {
    flex-shrink: 0;
  }

  .doc-icon-box {
    width: 46px;
    height: 46px;
    background-color: #eff6ff;
    color: var(--color-primary-blue);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #bfdbfe;
  }

  .thumbnail-img {
    width: 46px;
    height: 46px;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .details-container {
    flex-grow: 1;
  }

  .material-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .material-title-gujarati {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent-gold);
    margin-bottom: 0.4rem;
  }

  .material-desc {
    font-size: 0.875rem;
    color: var(--color-text-medium);
    line-height: 1.45;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
    gap: 0.75rem;
  }

  .meta-info {
    display: flex;
    flex-direction: column;
  }

  .size-meta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .downloads-meta {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .action-btn {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .card-footer {
      flex-direction: column;
      align-items: stretch;
    }
    .action-btn {
      width: 100%;
    }
  }
</style>
