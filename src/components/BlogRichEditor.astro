</style>

<script>
  import { Editor, Extension } from '@tiptap/core';
  import { StarterKit } from '@tiptap/starter-kit';
  import { Underline } from '@tiptap/extension-underline';
  import { Link } from '@tiptap/extension-link';
  import { Table } from '@tiptap/extension-table';
  import { TableRow } from '@tiptap/extension-table-row';
  import { TableCell } from '@tiptap/extension-table-cell';
  import { TableHeader } from '@tiptap/extension-table-header';
  import { TextAlign } from '@tiptap/extension-text-align';
  import { Highlight } from '@tiptap/extension-highlight';
  import { Color } from '@tiptap/extension-color';
  import { TextStyle } from '@tiptap/extension-text-style';
  import { Mathematics } from '@tiptap/extension-mathematics';
  import katex from 'katex';
  import DOMPurify from 'dompurify';

  // --- Custom Tiptap Extension: Line Spacing ---
  const LineHeight = Extension.create({
    name: 'lineHeight',

    addOptions() {
      return {
        types: ['paragraph', 'heading'],
        lineHeights: ['1.0', '1.15', '1.5', '2.0'],
        defaultLineHeight: null,
      };
    },

    addGlobalAttributes() {
      return [
        {
          types: this.options.types,
          attributes: {
            lineHeight: {
              default: this.options.defaultLineHeight,
              parseHTML: element => {
                const dataAttr = element.getAttribute('data-line-spacing');
                if (dataAttr && this.options.lineHeights.includes(dataAttr)) return dataAttr;
                const styleLh = element.style.lineHeight;
                if (styleLh && this.options.lineHeights.includes(styleLh)) return styleLh;
                return this.options.defaultLineHeight;
              },
              renderHTML: attributes => {
                if (!attributes.lineHeight) {
                  return {};
                }
                return {
                  'data-line-spacing': attributes.lineHeight,
                  style: `line-height: ${attributes.lineHeight}`
                };
              }
            }
          }
        }
      ];
    },

    addCommands() {
      return {
        setLineHeight: (lineHeight: string) => ({ commands }: any) => {
          if (!this.options.lineHeights.includes(lineHeight)) {
            return false;
          }
          return this.options.types
            .map(type => commands.updateAttributes(type, { lineHeight }))
            .some(response => response);
        },
        unsetLineHeight: () => ({ commands }: any) => {
          return this.options.types
            .map(type => commands.resetAttributes(type, 'lineHeight'))
            .some(response => response);
        }
      };
    }
  });

  // --- Custom Tiptap Extension: Paragraph Spacing ---
  const ParagraphSpacing = Extension.create({
    name: 'paragraphSpacing',

    addOptions() {
      return {
        types: ['paragraph', 'heading'],
        spacingOptions: ['compact', 'normal', 'relaxed', 'wide'],
        defaultSpacing: null,
        marginMap: {
          compact: '0.35em',
          normal: '0.75em',
          relaxed: '1.1em',
          wide: '1.5em'
        } as Record<string, string>
      };
    },

    addGlobalAttributes() {
      return [
        {
          types: this.options.types,
          attributes: {
            paragraphSpacing: {
              default: this.options.defaultSpacing,
              parseHTML: element => {
                const dataAttr = element.getAttribute('data-paragraph-spacing');
                if (dataAttr && this.options.spacingOptions.includes(dataAttr)) return dataAttr;
                return this.options.defaultSpacing;
              },
              renderHTML: attributes => {
                if (!attributes.paragraphSpacing) {
                  return {};
                }
                const mb = this.options.marginMap[attributes.paragraphSpacing] || attributes.paragraphSpacing;
                return {
                  'data-paragraph-spacing': attributes.paragraphSpacing,
                  style: `margin-bottom: ${mb}`
                };
              }
            }
          }
        }
      ];
    },

    addCommands() {
      return {
        setParagraphSpacing: (paragraphSpacing: string) => ({ commands }: any) => {
          if (!this.options.spacingOptions.includes(paragraphSpacing)) {
            return false;
          }
          return this.options.types
            .map(type => commands.updateAttributes(type, { paragraphSpacing }))
            .some(response => response);
        },
        unsetParagraphSpacing: () => ({ commands }: any) => {
          return this.options.types
            .map(type => commands.resetAttributes(type, 'paragraphSpacing'))
            .some(response => response);
        }
      };
    }
  });

  // Elements
  const root = document.getElementById('blogRichEditorRoot');
  const richInput = document.getElementById('content_rich_input') as HTMLInputElement;
  const markdownInput = document.getElementById('content_markdown_input') as HTMLTextAreaElement;
  const visualContainer = document.getElementById('visualEditorContainer');
  const markdownContainer = document.getElementById('markdownEditorContainer');
  const btnModeMarkdown = document.getElementById('btnModeMarkdown');
  const btnModeVisual = document.getElementById('btnModeVisual');

  const editorEl = document.getElementById('tiptapEditor');
  let currentMode: 'visual' | 'markdown' = markdownContainer && markdownContainer.style.display !== 'none' ? 'markdown' : 'visual';

  // Math Modal Elements
  const mathModal = document.getElementById('mathModal');
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const btnCancelMath = document.getElementById('btnCancelMath');
  const btnInsertMath = document.getElementById('btnInsertMath');
  const mathFormulaInput = document.getElementById('mathFormulaInput') as HTMLTextAreaElement;
  const katexLivePreview = document.getElementById('katexLivePreview');
  const mathTypeInline = document.getElementById('mathTypeInline') as HTMLInputElement;

  // Initialize Tiptap Editor
  const initialContent = richInput?.value || '';

  const editor = new Editor({
    element: editorEl || undefined,
    extensions: [
      StarterKit.configure({
        heading: {
          levels: [1, 2, 3, 4]
        }
      }),
      Underline,
      Link.configure({
        openOnClick: false,
        HTMLAttributes: {
          target: '_blank',
          rel: 'noopener noreferrer'
        }
      }),
      Table.configure({
        resizable: false
      }),
      TableRow,
      TableHeader,
      TableCell,
      TextAlign.configure({
        types: ['heading', 'paragraph']
      }),
      TextStyle,
      Color,
      Highlight.configure({
        multicolor: true
      }),
      Mathematics.configure({
        katexOptions: {
          throwOnError: false
        }
      }),
      LineHeight,
      ParagraphSpacing
    ],
    content: initialContent,
    onUpdate({ editor }) {
      syncContent();
      updateToolbarActiveStates();
    },
    onSelectionUpdate() {
      updateToolbarActiveStates();
    }
  });

  // Mode switching
  btnModeVisual?.addEventListener('click', () => {
    currentMode = 'visual';
    if (markdownContainer) markdownContainer.style.display = 'none';
    if (visualContainer) visualContainer.style.display = 'block';
    btnModeVisual.classList.add('active-mode');
    btnModeMarkdown?.classList.remove('active-mode');

    // If editor has no content but markdown textarea has text, convert basic paragraphs/headings
    if (!editor.getText().trim() && markdownInput?.value.trim()) {
      const md = markdownInput.value;
      const lines = md.split('\n').map(l => l.trim()).filter(Boolean);
      const html = lines.map(line => {
        if (line.startsWith('#### ')) return `<h4>${line.slice(5)}</h4>`;
        if (line.startsWith('### ')) return `<h3>${line.slice(4)}</h3>`;
        if (line.startsWith('## ')) return `<h2>${line.slice(3)}</h2>`;
        if (line.startsWith('# ')) return `<h1>${line.slice(2)}</h1>`;
        if (line.startsWith('- ') || line.startsWith('* ')) return `<ul><li>${line.slice(2)}</li></ul>`;
        return `<p>${line}</p>`;
      }).join('');
      editor.commands.setContent(html);
    }
  });

  btnModeMarkdown?.addEventListener('click', () => {
    currentMode = 'markdown';
    if (visualContainer) visualContainer.style.display = 'none';
    if (markdownContainer) markdownContainer.style.display = 'block';
    btnModeMarkdown.classList.add('active-mode');
    btnModeVisual?.classList.remove('active-mode');
  });

  // Sync content into hidden form input before submission
  function syncContent() {
    if (currentMode === 'visual') {
      const rawHtml = editor.getHTML();
      // Sanitize with DOMPurify while preserving data-type, data-latex, and spacing attributes
      const cleanHtml = DOMPurify.sanitize(rawHtml, {
        ADD_TAGS: ['span', 'div', 'hr', 'mark', 'u', 's'],
        ADD_ATTR: ['data-type', 'data-latex', 'target', 'rel', 'style', 'colspan', 'rowspan', 'data-line-spacing', 'data-paragraph-spacing']
      });
      if (richInput) richInput.value = cleanHtml;
    }
  }

  // Intercept closest form submit
  const form = root?.closest('form');
  form?.addEventListener('submit', () => {
    syncContent();
  });

  // Toolbar Actions
  const tbHeadingSelect = document.getElementById('tbHeadingSelect') as HTMLSelectElement;
  tbHeadingSelect?.addEventListener('change', (e) => {
    const val = (e.target as HTMLSelectElement).value;
    if (val === 'p') editor.chain().focus().setParagraph().run();
    else if (val === 'h1') editor.chain().focus().toggleHeading({ level: 1 }).run();
    else if (val === 'h2') editor.chain().focus().toggleHeading({ level: 2 }).run();
    else if (val === 'h3') editor.chain().focus().toggleHeading({ level: 3 }).run();
    else if (val === 'h4') editor.chain().focus().toggleHeading({ level: 4 }).run();
  });

  const tbLineSpacingSelect = document.getElementById('tbLineSpacingSelect') as HTMLSelectElement;
  tbLineSpacingSelect?.addEventListener('change', (e) => {
    const val = (e.target as HTMLSelectElement).value;
    if (val) {
      (editor.chain().focus() as any).setLineHeight(val).run();
    } else {
      (editor.chain().focus() as any).unsetLineHeight().run();
    }
  });

  const tbParagraphSpacingSelect = document.getElementById('tbParagraphSpacingSelect') as HTMLSelectElement;
  tbParagraphSpacingSelect?.addEventListener('change', (e) => {
    const val = (e.target as HTMLSelectElement).value;
    if (val) {
      (editor.chain().focus() as any).setParagraphSpacing(val).run();
    } else {
      (editor.chain().focus() as any).unsetParagraphSpacing().run();
    }
  });

  document.getElementById('tbBold')?.addEventListener('click', () => editor.chain().focus().toggleBold().run());
  document.getElementById('tbItalic')?.addEventListener('click', () => editor.chain().focus().toggleItalic().run());
  document.getElementById('tbUnderline')?.addEventListener('click', () => editor.chain().focus().toggleUnderline().run());
  document.getElementById('tbStrike')?.addEventListener('click', () => editor.chain().focus().toggleStrike().run());

  // Colors
  const tbTextColor = document.getElementById('tbTextColor') as HTMLInputElement;
  tbTextColor?.addEventListener('input', (e) => {
    const col = (e.target as HTMLInputElement).value;
    editor.chain().focus().setColor(col).run();
    const ind = document.getElementById('textColorIndicator');
    if (ind) ind.style.color = col;
  });

  const tbHighlightColor = document.getElementById('tbHighlightColor') as HTMLInputElement;
  tbHighlightColor?.addEventListener('input', (e) => {
    const col = (e.target as HTMLInputElement).value;
    editor.chain().focus().toggleHighlight({ color: col }).run();
  });

  document.getElementById('tbClearColor')?.addEventListener('click', () => {
    editor.chain().focus().unsetColor().unsetHighlight().run();
  });

  // Alignment
  document.getElementById('tbAlignLeft')?.addEventListener('click', () => editor.chain().focus().setTextAlign('left').run());
  document.getElementById('tbAlignCenter')?.addEventListener('click', () => editor.chain().focus().setTextAlign('center').run());
  document.getElementById('tbAlignRight')?.addEventListener('click', () => editor.chain().focus().setTextAlign('right').run());
  document.getElementById('tbAlignJustify')?.addEventListener('click', () => editor.chain().focus().setTextAlign('justify').run());

  // Lists & Structure
  document.getElementById('tbBulletList')?.addEventListener('click', () => editor.chain().focus().toggleBulletList().run());
  document.getElementById('tbOrderedList')?.addEventListener('click', () => editor.chain().focus().toggleOrderedList().run());
  document.getElementById('tbBlockquote')?.addEventListener('click', () => editor.chain().focus().toggleBlockquote().run());
  document.getElementById('tbHorizontalRule')?.addEventListener('click', () => editor.chain().focus().setHorizontalRule().run());

  // Links
  document.getElementById('tbLink')?.addEventListener('click', () => {
    const prev = editor.getAttributes('link').href || '';
    const url = prompt('Enter Web Link URL (વેબસાઇટ લિંક દાખલ કરો):', prev);
    if (url === null) return;
    if (url === '') {
      editor.chain().focus().extendMarkRange('link').unsetLink().run();
    } else {
      editor.chain().focus().extendMarkRange('link').setLink({ href: url }).run();
    }
  });

  // Table operations
  document.getElementById('tbInsertTable')?.addEventListener('click', () => {
    editor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run();
  });
  document.getElementById('tbAddRowAfter')?.addEventListener('click', () => editor.chain().focus().addRowAfter().run());
  document.getElementById('tbDeleteRow')?.addEventListener('click', () => editor.chain().focus().deleteRow().run());
  document.getElementById('tbAddColAfter')?.addEventListener('click', () => editor.chain().focus().addColumnAfter().run());
  document.getElementById('tbDeleteCol')?.addEventListener('click', () => editor.chain().focus().deleteColumn().run());
  document.getElementById('tbDeleteTable')?.addEventListener('click', () => editor.chain().focus().deleteTable().run());

  // Undo / Redo
  document.getElementById('tbUndo')?.addEventListener('click', () => editor.chain().focus().undo().run());
  document.getElementById('tbRedo')?.addEventListener('click', () => editor.chain().focus().redo().run());

  // Update Toolbar states
  function updateToolbarActiveStates() {
    if (!editor) return;

    toggleBtnClass('tbBold', editor.isActive('bold'));
    toggleBtnClass('tbItalic', editor.isActive('italic'));
    toggleBtnClass('tbUnderline', editor.isActive('underline'));
    toggleBtnClass('tbStrike', editor.isActive('strike'));
    toggleBtnClass('tbBulletList', editor.isActive('bulletList'));
    toggleBtnClass('tbOrderedList', editor.isActive('orderedList'));
    toggleBtnClass('tbBlockquote', editor.isActive('blockquote'));
    toggleBtnClass('tbAlignLeft', editor.isActive({ textAlign: 'left' }));
    toggleBtnClass('tbAlignCenter', editor.isActive({ textAlign: 'center' }));
    toggleBtnClass('tbAlignRight', editor.isActive({ textAlign: 'right' }));
    toggleBtnClass('tbAlignJustify', editor.isActive({ textAlign: 'justify' }));

    if (tbHeadingSelect) {
      if (editor.isActive('heading', { level: 1 })) tbHeadingSelect.value = 'h1';
      else if (editor.isActive('heading', { level: 2 })) tbHeadingSelect.value = 'h2';
      else if (editor.isActive('heading', { level: 3 })) tbHeadingSelect.value = 'h3';
      else if (editor.isActive('heading', { level: 4 })) tbHeadingSelect.value = 'h4';
      else tbHeadingSelect.value = 'p';
    }

    if (tbLineSpacingSelect) {
      const activeLh = editor.getAttributes('paragraph')?.lineHeight || editor.getAttributes('heading')?.lineHeight || '';
      tbLineSpacingSelect.value = activeLh;
    }

    if (tbParagraphSpacingSelect) {
      const activePs = editor.getAttributes('paragraph')?.paragraphSpacing || editor.getAttributes('heading')?.paragraphSpacing || '';
      tbParagraphSpacingSelect.value = activePs;
    }
  }

  function toggleBtnClass(btnId: string, isActive: boolean) {
    const el = document.getElementById(btnId);
    if (el) {
      if (isActive) el.classList.add('is-active');
      else el.classList.remove('is-active');
    }
  }

  // --- Math Modal Logic ---
  if (mathModal && mathModal.parentElement !== document.body) {
    document.body.appendChild(mathModal);
  }

  document.getElementById('tbMathBtn')?.addEventListener('click', () => {
    openMathModal();
  });

  modalCloseBtn?.addEventListener('click', closeMathModal);
  btnCancelMath?.addEventListener('click', closeMathModal);

  function openMathModal() {
    if (mathModal) {
      if (mathModal.parentElement !== document.body) {
        document.body.appendChild(mathModal);
      }
      mathModal.style.display = 'flex';
    }
    if (mathFormulaInput) {
      mathFormulaInput.focus();
      renderLiveKaTeX(mathFormulaInput.value);
    }
  }

  function closeMathModal() {
    if (mathModal) mathModal.style.display = 'none';
  }

  function renderLiveKaTeX(expr: string) {
    if (!katexLivePreview) return;
    const trimmed = expr.trim();
    if (!trimmed) {
      katexLivePreview.innerHTML = '<span class="preview-empty">Type formula or click templates below to preview...</span>';
      return;
    }
    try {
      const isDisplay = !mathTypeInline?.checked;
      katex.render(trimmed, katexLivePreview, {
        displayMode: isDisplay,
        throwOnError: false
      });
    } catch (e: any) {
      katexLivePreview.innerHTML = `<span class="katex-error">${e?.message || 'Invalid formula'}</span>`;
    }
  }

  mathFormulaInput?.addEventListener('input', () => {
    renderLiveKaTeX(mathFormulaInput.value);
  });

  document.querySelectorAll('input[name="math_display_type"]').forEach(radio => {
    radio.addEventListener('change', () => {
      renderLiveKaTeX(mathFormulaInput?.value || '');
    });
  });

  // Helper to insert snippet into textarea at cursor
  function insertIntoFormula(snippet: string) {
    if (!mathFormulaInput) return;
    const start = mathFormulaInput.selectionStart || 0;
    const end = mathFormulaInput.selectionEnd || 0;
    const val = mathFormulaInput.value;
    mathFormulaInput.value = val.substring(0, start) + snippet + val.substring(end);
    mathFormulaInput.selectionStart = mathFormulaInput.selectionEnd = start + snippet.length;
    mathFormulaInput.focus();
    renderLiveKaTeX(mathFormulaInput.value);
  }

  // Builder Buttons
  document.getElementById('btnInsertFrac')?.addEventListener('click', () => {
    const num = (document.getElementById('bldFracNum') as HTMLInputElement)?.value || 'a';
    const den = (document.getElementById('bldFracDen') as HTMLInputElement)?.value || 'b';
    insertIntoFormula(`\\frac{${num}}{${den}}`);
  });

  document.getElementById('btnInsertPow')?.addEventListener('click', () => {
    const base = (document.getElementById('bldPowBase') as HTMLInputElement)?.value || 'x';
    const exp = (document.getElementById('bldPowExp') as HTMLInputElement)?.value || '2';
    insertIntoFormula(`{${base}}^{${exp}}`);
  });

  document.getElementById('btnInsertSub')?.addEventListener('click', () => {
    const base = (document.getElementById('bldSubBase') as HTMLInputElement)?.value || 'x';
    const sub = (document.getElementById('bldSubVal') as HTMLInputElement)?.value || '1';
    insertIntoFormula(`{${base}}_{${sub}}`);
  });

  document.getElementById('btnInsertRoot')?.addEventListener('click', () => {
    const idx = (document.getElementById('bldRootIndex') as HTMLInputElement)?.value.trim();
    const expr = (document.getElementById('bldRootExpr') as HTMLInputElement)?.value || 'x';
    if (idx) insertIntoFormula(`\\sqrt[${idx}]{${expr}}`);
    else insertIntoFormula(`\\sqrt{${expr}}`);
  });

  // Clickable Symbol Buttons
  document.querySelectorAll('.sym-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const latex = btn.getAttribute('data-latex');
      if (latex) insertIntoFormula(latex + ' ');
    });
  });

  // Formula Chips
  document.querySelectorAll('.chip-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const latex = btn.getAttribute('data-latex');
      if (latex) {
        if (mathFormulaInput) {
          mathFormulaInput.value = latex;
          renderLiveKaTeX(latex);
        }
      }
    });
  });

  // Insert Formula into Tiptap
  btnInsertMath?.addEventListener('click', () => {
    const latex = mathFormulaInput?.value.trim();
    if (!latex) {
      alert('Please enter or build a formula first.');
      return;
    }

    const isInline = mathTypeInline?.checked;
    if (isInline) {
      // @ts-ignore
      editor.commands.insertInlineMath({ latex });
    } else {
      // @ts-ignore
      editor.commands.insertBlockMath({ latex });
    }

    closeMathModal();
    if (mathFormulaInput) mathFormulaInput.value = '';
    editor.commands.focus();
  });
</script>
