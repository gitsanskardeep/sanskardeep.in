---
import type { TestRecord } from '../db/schema';

interface Props {
  test: TestRecord;
}

const { test } = Astro.props;

const targetUrl = test.external_url || test.download_url || null;

function formatDuration(minutes: number): string {
  if (!minutes) return '—';
  if (minutes < 60) return `${minutes} Mins`;
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return m > 0 ? `${h} Hr ${m} Mins` : `${h} ${h === 1 ? 'Hour' : 'Hours'}`;
}

const formattedDuration = formatDuration(test.duration_minutes);

const difficultyClass: Record<string, string> = {
  'Easy': 'difficulty-easy',
  'Medium': 'difficulty-medium',
  'Hard': 'difficulty-hard',
  'Board Standard': 'difficulty-board'
};
const diffClass = difficultyClass[test.difficulty] || 'difficulty-medium';
---

<div class="card test-card">
  <!-- Card Top: Badges -->
  <div class="card-top">
    <div class="badge-group">
      {test.className && <span class="badge badge-accent">{test.className}</span>}
      {test.subjectName && <span class="badge badge-primary">{test.subjectName}</span>}
    </div>
    <span class={`difficulty-badge ${diffClass}`}>{test.difficulty}</span>
  </div>

  <!-- Test Type pill -->
  <div class="type-row">
    <span class="type-pill">{test.test_type}</span>
    {test.medium && test.medium !== 'Gujarati' && (
      <span class="medium-pill">{test.medium} Medium</span>
    )}
  </div>

  <!-- Card Body -->
  <div class="card-body">
    {test.thumbnail_url ? (
      <img src={test.thumbnail_url} alt={test.title} class="thumbnail-img" loading="lazy" />
    ) : (
      <div class="test-icon-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
    )}

    <div class="test-content">
      <h3 class="test-title">{test.title}</h3>
      {test.chapter && (
        <p class="test-chapter">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 7 4 4 20 4 20 7"></polyline>
            <line x1="9" y1="20" x2="15" y2="20"></line>
            <line x1="12" y1="4" x2="12" y2="20"></line>
          </svg>
          <span>{test.chapter}</span>
        </p>
      )}
      {test.description && (
        <p class="test-desc">{test.description.slice(0, 120)}{test.description.length > 120 ? '…' : ''}</p>
      )}
    </div>
  </div>

  <!-- Meta Row: Marks, Duration -->
  <div class="test-meta">
    <div class="meta-item">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="7"></circle>
        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
      </svg>
      <span><strong>{test.total_marks}</strong> Marks</span>
    </div>
    <div class="meta-item">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span><strong>{formattedDuration}</strong></span>
    </div>
  </div>

  <!-- Card Footer: CTA -->
  <div class="card-footer">
    {targetUrl ? (
      <a
        href={targetUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm btn-primary action-btn"
        aria-label={`View or Download test paper: ${test.title}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        <span>View / Download Paper</span>
      </a>
    ) : (
      <span class="coming-soon-badge">Coming Soon</span>
    )}
    {test.download_url && test.external_url && (
      <a
        href={test.download_url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm btn-outline download-btn"
        aria-label={`Download: ${test.title}`}
        title="Direct Download Link"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </a>
    )}
  </div>
</div>

<style>
  .test-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-top: 3px solid var(--color-accent-gold);
    background-color: var(--color-surface);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .test-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .difficulty-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .difficulty-easy { background-color: #dcfce7; color: #166534; }
  .difficulty-medium { background-color: #fef9c3; color: #854d0e; }
  .difficulty-hard { background-color: #fee2e2; color: #991b1b; }
  .difficulty-board { background-color: #e0e7ff; color: #3730a3; }

  .type-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .type-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e3a5f;
    background-color: #dbeafe;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .medium-pill {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .card-body {
    display: flex;
    gap: 0.85rem;
    flex: 1;
    margin-bottom: 0.85rem;
  }

  .test-icon-box {
    width: 52px;
    height: 52px;
    min-width: 52px;
    background-color: #f0f4ff;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-blue);
  }

  .thumbnail-img {
    width: 52px;
    height: 52px;
    min-width: 52px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .test-content {
    flex: 1;
    min-width: 0;
  }

  .test-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    line-height: 1.4;
    margin-bottom: 0.35rem;
  }

  .test-chapter {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  .test-desc {
    font-size: 0.825rem;
    color: var(--color-text-medium);
    line-height: 1.55;
  }

  .test-meta {
    display: flex;
    gap: 1.25rem;
    padding: 0.6rem 0.75rem;
    background-color: #f8fafc;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.825rem;
    color: var(--color-text-medium);
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
  }

  .action-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .download-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.65rem;
  }

  .coming-soon-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    font-size: 0.8rem;
    color: #94a3b8;
    background-color: #f1f5f9;
    border: 1px dashed #cbd5e1;
    border-radius: var(--radius-sm);
    font-style: italic;
  }
</style>
