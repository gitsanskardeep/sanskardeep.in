---
import { getPublishedTests } from '../lib/tests';
import TestCard from './TestCard.astro';
import type { TestRecord } from '../db/schema';

// Fetch live tests from D1
let liveTests: TestRecord[] = [];
try {
  const { env } = await import('cloudflare:workers');
  const db = (env as Record<string, unknown>).DB as import('@cloudflare/workers-types').D1Database | undefined;
  if (db) {
    const results = await getPublishedTests(db);
    if (results && results.length > 0) {
      liveTests = results.slice(0, 4);
    }
  }
} catch {
  // Local dev or missing binding
}
---

<section class="section" id="tests">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Practice &amp; Evaluate • ટેસ્ટ શ્રેણી</span>
      <h2 class="section-title">Tests &amp; Practice Papers</h2>
      <p class="section-desc">
        Evaluate your understanding with GSEB pattern unit tests, chapter quizzes, and full 100-mark board model exam papers.
      </p>
    </div>

    {liveTests.length > 0 ? (
      <div class="grid-2 ts-grid">
        {liveTests.map(test => (
          <TestCard test={test} />
        ))}
      </div>
    ) : (
      <div class="ts-empty">
        <div class="ts-empty-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <p class="ts-empty-title">No Tests Available Yet</p>
        <p class="ts-empty-desc">New Gujarat Board practice test papers and model question sets will be added soon.</p>
        <a href="/tests" class="btn btn-outline btn-sm">View Tests &amp; Practice Directory &rarr;</a>
      </div>
    )}

    <!-- CTA Banner -->
    <div class="ts-banner">
      <div class="ts-banner-content">
        <h3 class="ts-banner-title">Access Our Full Tests &amp; Practice Archive</h3>
        <p class="ts-banner-text">
          Unit tests, chapter quizzes, MCQ practice sets, and board model papers — all free for Gujarat Board students.
        </p>
      </div>
      <a href="/tests" class="btn btn-accent ts-banner-btn">Explore All Practice Tests</a>
    </div>
  </div>
</section>

<style>
  /* Grid: cards align to full height */
  .ts-grid {
    align-items: stretch;
    margin-bottom: 0;
  }

  /* Empty state */
  .ts-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
    padding: 3rem 1.5rem;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border-dark);
    border-radius: var(--radius-md);
    margin-bottom: 2.5rem;
  }

  .ts-empty-icon {
    width: 56px;
    height: 56px;
    background-color: #f1f5f9;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    margin-bottom: 0.15rem;
    flex-shrink: 0;
  }

  .ts-empty-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-navy);
  }

  .ts-empty-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 400px;
    line-height: 1.55;
  }

  /* CTA Banner */
  .ts-banner {
    margin-top: 3rem;
    background-color: var(--color-primary-navy);
    color: #ffffff;
    padding: 1.75rem 2.25rem;
    border-radius: var(--radius-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .ts-banner-title {
    color: #ffffff;
    font-size: 1.25rem;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .ts-banner-text {
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .ts-banner-btn {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .ts-banner {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
      gap: 1.25rem;
    }
    .ts-banner-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
