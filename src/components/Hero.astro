---
import { SITE_INFO } from '../data/portalData';
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <!-- Tagline & GSEB Focus Badge -->
      <div class="hero-badge-group">
        <span class="hero-badge hero-badge-gseb">Gujarat Board (GSEB) Std 9 to 12</span>
        <span class="hero-badge hero-badge-free">100% Free Resources</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        <span class="brand-title">SANSKAR DEEP</span>
        <span class="hero-subtitle">Educational Portal</span>
      </h1>

      <!-- Gujarati Tagline & Subheading -->
      <p class="hero-tagline gujarati-text">
        "{SITE_INFO.taglineGujarati}"
      </p>

      <p class="hero-description">
        Comprehensive learning ecosystem for Std 9, 10, 11 & 12 students across Gujarat. Access high-quality chapter revision notes, GSEB model question papers, blueprints, and online practice tests.
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="#classes" class="btn btn-primary hero-btn">
          <span>Explore Classes (ધોરણ ૯ - ૧૨)</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#study-material" class="btn btn-outline hero-btn">
          <span>Study Material</span>
        </a>
      </div>

      <!-- Key Features List -->
      <div class="hero-highlights">
        <div class="highlight-item">
          <div class="highlight-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span>GSEB Blueprint Aligned</span>
        </div>

        <div class="highlight-item">
          <div class="highlight-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span>Chapter-wise IMP Notes</span>
        </div>

        <div class="highlight-item">
          <div class="highlight-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span>Board Practice Papers</span>
        </div>
      </div>
    </div>

    <!-- Hero Visual displaying Official Large Emblem Logo -->
    <div class="hero-visual">
      <div class="emblem-card">
        <div class="emblem-wrapper">
          <img 
            src="/images/logo-emblem-large.png" 
            alt="Sanskar Deep Official Educational Seal - Since 2006" 
            class="emblem-img"
            width="320"
            height="320"
            loading="eager"
          />
        </div>

        <div class="emblem-info">
          <h3 class="emblem-heading">Gujarat Board Learning Companion</h3>
          <p class="emblem-sub gujarati-text">"આ નો ભદ્રાઃ ક્રતવો યન્તુ વિશ્વતઃ"</p>
        </div>
        
        <div class="stat-grid">
          <div class="stat-box">
            <span class="stat-number">Std 9–12</span>
            <span class="stat-label">Full Syllabus</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">100%</span>
            <span class="stat-label">Free Access</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">Sci & Com</span>
            <span class="stat-label">Both Streams</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">Since 2006</span>
            <span class="stat-label">Trust & Excellence</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: linear-gradient(180deg, #ffffff 0%, var(--color-bg-alt) 100%);
    padding: 4.5rem 0 5rem 0;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .hero-badge {
    padding: 0.3rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: var(--radius-full);
  }

  .hero-badge-gseb {
    background-color: #eff6ff;
    color: var(--color-primary-blue);
    border: 1px solid #bfdbfe;
  }

  .hero-badge-free {
    background-color: var(--color-gold-light);
    color: var(--color-gold-dark);
    border: 1px solid #fde68a;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .brand-title {
    font-size: 3.25rem;
    font-weight: 900;
    color: var(--color-primary-navy);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero-subtitle {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent-blue);
    letter-spacing: -0.01em;
  }

  .hero-tagline {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent-gold);
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--color-text-medium);
    margin-bottom: 2rem;
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .hero-btn {
    padding: 0.85rem 1.75rem;
    font-size: 1rem;
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-medium);
  }

  .highlight-icon {
    width: 24px;
    height: 24px;
    background-color: #dcfce7;
    color: #15803d;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Emblem Hero Card */
  .emblem-card {
    background-color: var(--color-surface);
    border: 2px solid var(--color-primary-navy);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: 0 20px 25px -5px rgba(15, 41, 66, 0.12), 0 8px 10px -6px rgba(15, 41, 66, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .emblem-wrapper {
    margin-bottom: 1.25rem;
    padding: 0.5rem;
    background-color: #ffffff;
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
  }

  .emblem-img {
    width: 240px;
    height: 240px;
    object-fit: contain;
    display: block;
  }

  .emblem-info {
    margin-bottom: 1.25rem;
  }

  .emblem-heading {
    font-size: 1.2rem;
    color: var(--color-primary-navy);
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .emblem-sub {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-accent-gold);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    width: 100%;
  }

  .stat-box {
    background-color: var(--color-bg-main);
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    border-radius: var(--radius-md);
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-primary-blue);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .brand-title {
      font-size: 2.5rem;
    }
    .hero-subtitle {
      font-size: 1.6rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 2.5rem 0 3rem 0;
    }
    .brand-title {
      font-size: 2.1rem;
    }
    .hero-subtitle {
      font-size: 1.35rem;
    }
    .hero-tagline {
      font-size: 1.1rem;
    }
    .hero-btn {
      width: 100%;
    }
    .emblem-img {
      width: 190px;
      height: 190px;
    }
  }
</style>
