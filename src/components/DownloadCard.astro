---
import type { DownloadRecord } from '../db/schema';

interface Props {
  download: DownloadRecord;
  variant?: 'standard' | 'featured' | 'compact' | 'minimal';
}

const { download, variant = 'standard' } = Astro.props;

// Formatting file size
function formatBytes(bytes: number): string {
  if (!bytes || bytes === 0) return 'PDF File';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}

const formattedSize = formatBytes(download.file_size_bytes);
const targetUrl = download.external_url || download.download_url || '#';
---

<div class={`card download-card variant-${variant}`}>
  {/* Card Header Badges */}
  <div class="card-top">
    <div class="badge-group">
      {download.className && <span class="badge badge-accent">{download.className}</span>}
      {download.subjectName && <span class="badge badge-primary">{download.subjectName}</span>}
      {download.categoryName && <span class="badge badge-category">{download.categoryName}</span>}
    </div>
    <span class="file-type-badge">{download.file_type || 'PDF'}</span>
  </div>

  {/* Main Content Body */}
  <div class="card-body">
    <div class="icon-container">
      {download.thumbnail_url ? (
        <img src={download.thumbnail_url} alt={download.title} class="thumbnail-img" />
      ) : (
        <div class="pdf-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="12" y1="18" x2="12" y2="12"></line>
            <polyline points="9 15 12 18 15 15"></polyline>
          </svg>
        </div>
      )}
    </div>

    <div class="details-container">
      <h3 class="download-title">{download.title}</h3>
      {download.description && <p class="download-desc">{download.description}</p>}
    </div>
  </div>

  {/* Card Footer Actions & Meta */}
  <div class="card-footer">
    <div class="meta-info">
      <span class="size-meta">{formattedSize}</span>
      {download.download_count > 0 && (
        <span class="downloads-meta">{download.download_count.toLocaleString()}+ downloads</span>
      )}
    </div>

    <a 
      href={targetUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="btn btn-sm btn-primary action-btn"
      aria-label={`View PDF for ${download.title}`}
    >
      <span>View / Download PDF</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>
</div>

<style>
  .download-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-top: 3px solid var(--color-primary-navy);
    background-color: var(--color-surface);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .download-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 0.5rem;
  }

  .badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge-category {
    background-color: #f1f5f9;
    color: var(--color-text-medium);
    border: 1px solid var(--color-border);
  }

  .file-type-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: #dc2626;
    background-color: #fee2e2;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .card-body {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .icon-container {
    flex-shrink: 0;
  }

  .pdf-icon-box {
    width: 46px;
    height: 46px;
    background-color: #fee2e2;
    color: #dc2626;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumbnail-img {
    width: 46px;
    height: 46px;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .details-container {
    flex-grow: 1;
  }

  .download-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }

  .download-desc {
    font-size: 0.875rem;
    color: var(--color-text-medium);
    line-height: 1.45;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
    gap: 0.75rem;
  }

  .meta-info {
    display: flex;
    flex-direction: column;
  }

  .size-meta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .downloads-meta {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .action-btn {
    white-space: nowrap;
  }

  /* Variant Specific AI Card Suggestions Readiness */
  .variant-compact .download-title {
    font-size: 0.95rem;
  }

  .variant-featured {
    border-top-color: var(--color-accent-gold);
    background: linear-gradient(180deg, #ffffff 0%, #fefce8 100%);
  }

  @media (max-width: 640px) {
    .card-footer {
      flex-direction: column;
      align-items: stretch;
    }
    .action-btn {
      width: 100%;
    }
  }
</style>
